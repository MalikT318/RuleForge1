/*
  MITRE Technique : T1674 - Input Injection
  Tactic(s)       : Execution
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:18:29.892780+00:00
  Reference       : https://attack.mitre.org/techniques/T1674
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1674_Linux_Terminal_Spawned_Process_External_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Network-side proxy for keystroke-injected command execution (T1674). Input injection leaves no network artefact of its own. Its typical result is a terminal emulator launching a shell, interpreter or downloader (for example a HID-emulating USB device or xdotool/uinput typing a one-liner) that immediately reaches an external address. This rule fires when a downloader, shell or interpreter whose parent is a graphical terminal emulator opens an outbound connection to a non-internal address."
    mitre_tactic = "Execution"
    mitre_technique = "T1674"
    mitre_technique_name = "Input Injection"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd socket/connect events) that populates principal.process and principal.process.parent_process paths on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Administrators or developers running curl, wget or scripts interactively from a desktop terminal (package installs, git or API calls, downloads); developer workstations; approved remote support sessions."
    tuning_guidance = "Add approved tooling binaries to %global_allowed_admin_tools, approved automation hosts or parents to %global_allowed_script_hosts, and expected administrators to %global_allowed_admin_users. Add vendor and update destinations to %global_allowed_domains where hostname enrichment is available. Consider restricting to workstation assets, as servers rarely run a graphical terminal."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.parent_process.file.full_path = /\/(gnome-terminal-server|gnome-terminal|xterm|konsole|xfce4-terminal|lxterminal|mate-terminal|tilix|terminator|alacritty|kitty)$/ nocase
    $net.principal.process.file.full_path = /\/(curl|wget|bash|sh|dash|zsh|python[0-9.]*|perl|nc|ncat|socat)$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_script_hosts
    not $net.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1674")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
