/*
  MITRE Technique : T1542.002 - Component Firmware
  Tactic(s)       : Stealth, Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:44:05.259213+00:00
  Reference       : https://attack.mitre.org/techniques/T1542/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1542_002_Storage_Firmware_Update_Via_PowerShell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a PowerShell host invoking the built-in Update-StorageFirmware cmdlet, which writes a firmware image to a storage device (disk, SSD, NVMe). This is the native Windows mechanism for flashing component firmware from the OS. Malicious firmware on a storage controller or drive survives OS reinstall and disk re-imaging, and is invisible to host-based integrity checks."
    mitre_tactic = "Stealth, Persistence"
    mitre_technique = "T1542.002"
    mitre_technique_name = "Pre-OS Boot: Component Firmware"
    log_prerequisites = "Requires EDR or Sysmon process-creation telemetry with full command lines (or Windows Event 4688 with command-line auditing enabled), normalised to UDM PROCESS_LAUNCH."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Authorised hardware firmware maintenance by IT or datacentre teams, OEM drive firmware update workflows, hardware lifecycle and patching automation, lab or imaging systems."
    tuning_guidance = "Add approved patching or deployment parent processes to %global_allowed_admin_tools and named change-window administrators to %global_allowed_admin_users. Correlate hits with change tickets. Any hit on a non-server or end-user workstation, or from a non-administrative context, should be treated as high priority."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    $proc.target.process.command_line = /\bUpdate-StorageFirmware\b/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1542.002")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
