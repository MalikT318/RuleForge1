/*
  MITRE Technique : T1041 - Exfiltration Over C2 Channel
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 1h
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:59:14.314633+00:00
  Reference       : https://attack.mitre.org/techniques/T1041
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1041_Linux_FW_Beaconing_Then_Large_Outbound_Transfer {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Perimeter-observed C2-style exfiltration. An internal host makes repeated small outbound connections (beaconing) to one external IP and port, then sends a large volume of data to the same destination within one hour. Scope the firewall log feed to Linux server segments, since firewall telemetry carries no OS or process context."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1041"
    mitre_technique_name = "Exfiltration Over C2 Channel"
    log_prerequisites = "Firewall or proxy flow logs normalised to UDM NETWORK_FLOW with principal.ip, target.ip, target.port and network.sent_bytes populated. Linux server subnets should be identifiable by the client's log scoping."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Backup and replication jobs to cloud storage, software mirroring and package sync, log shipping to SaaS SIEM or monitoring, database replication to an external site, legitimate telemetry agents followed by a large upload."
    tuning_guidance = "Add known-good external destination domains to %global_allowed_domains. Raise the byte threshold (52428800 = 50 MB) or the beacon count (#beacon >= 5) for noisy backup or replication hosts. Restrict the rule to Linux server address groups at the log-source level. Add authorised scanners or test sources to %global_allowed_scanners."

  events:
    $beacon.metadata.event_type = "NETWORK_FLOW"
    $beacon.principal.ip = $src_ip
    $beacon.target.ip = $dst_ip
    $beacon.target.port = $dst_port
    $beacon.network.sent_bytes > 0
    $beacon.network.sent_bytes < 5000
    not $beacon.target.ip in %rfc1918_internal
    not $beacon.target.hostname in %global_allowed_domains
    not $beacon.principal.ip in %global_allowed_scanners

    $xfer.metadata.event_type = "NETWORK_FLOW"
    $xfer.principal.ip = $src_ip
    $xfer.target.ip = $dst_ip
    $xfer.target.port = $dst_port
    $xfer.network.sent_bytes > 52428800
    not $xfer.target.ip in %rfc1918_internal
    not $xfer.target.hostname in %global_allowed_domains
    not $xfer.principal.ip in %global_allowed_scanners

    $beacon.metadata.event_timestamp.seconds <= $xfer.metadata.event_timestamp.seconds

  match:
    $src_ip, $dst_ip, $dst_port over 1h

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1041")
    $primary_entity = array_distinct($src_ip)
    $destination_ips = array_distinct($dst_ip)
    $destination_ports = array_distinct($dst_port)
    $beacon_count = count($beacon.metadata.id)
    $max_bytes_sent = max($xfer.network.sent_bytes)

  condition:
    #beacon >= 5 and $xfer
}
