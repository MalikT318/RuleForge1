/*
  MITRE Technique : T1027.014 - Polymorphic Code
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Obfuscation / Deobfuscation
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:01:06.182036+00:00
  Reference       : https://attack.mitre.org/techniques/T1027/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1027_014_Randomized_Binary_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an external network connection from an executable that runs from a user-writable directory and has a machine-generated-looking file name (8-32 alphanumeric characters mixing letters and digits). Polymorphic and mutation-engine malware typically drops a freshly renamed or regenerated binary on each run and then calls out to staging or C2 infrastructure. This is the network-side view and complements process-creation rules."
    mitre_tactic = "Stealth"
    mitre_technique = "T1027.014"
    mitre_technique_name = "Obfuscated Files or Information: Polymorphic Code"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Per-user self-updating applications that run randomly named binaries from AppData or Temp (e.g. some installers, collaboration clients, game launchers), software deployment stubs, portable tools run by admins, and developer build outputs."
    tuning_guidance = "Add approved tooling executable paths to %global_allowed_admin_tools and EDR/AV agents to %global_allowed_security_tools. Add known-good vendor update destinations to %global_allowed_domains. Add approved remote-support tooling to %global_allowed_remote_mgmt. Raise severity for servers or for hosts with no software-installation rights."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    $net.target.port > 0
    $net.principal.process.file.full_path = /\\(appdata|temp|programdata|users\\public|windows\\temp)\\/ nocase
    $net.principal.process.file.full_path = /\\[a-z0-9]{8,32}\.exe$/ nocase
    $net.principal.process.file.full_path = /\\[a-z0-9]*[0-9][a-z0-9]*\.exe$/ nocase
    $net.principal.process.file.full_path = /\\[a-z0-9]*[a-z][a-z0-9]*\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.process.file.full_path in %global_allowed_remote_mgmt
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1027.014")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
