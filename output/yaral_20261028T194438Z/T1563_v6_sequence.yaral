/*
  MITRE Technique : T1563 - Remote Service Session Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:07:35.404372+00:00
  Reference       : https://attack.mitre.org/techniques/T1563
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_Chained_RDP_Pivot_Session_Hijack {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a chained RDP hop seen at the network perimeter: host A opens an RDP connection to a pivot host, and within 10 minutes that pivot host opens its own RDP connection to a different host. This pattern is consistent with an attacker hijacking or riding an established remote desktop session to move laterally. Firewall logs cannot see the hijack itself, so this rule detects the network-observable chain of sessions."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563"
    mitre_technique_name = "Remote Service Session Hijacking"
    log_prerequisites = "Requires firewall, proxy or perimeter flow logs normalised to UDM NETWORK_CONNECTION with populated principal.ip, target.ip and target.port. Internal east-west RDP traffic must traverse a logging firewall or segment gateway."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Administrators hopping through a jump server or bastion host, helpdesk staff remoting into a server and then onward to a workstation, RDP gateway or connection broker infrastructure, and VDI brokers making onward connections."
    tuning_guidance = "Add jump hosts, bastions, RDP gateways and VDI brokers to %global_allowed_mgmt_sources. For noisy environments, restrict the rule to server subnets via the log source, or raise the severity only when the first hop's source is not an administrative source."

  events:
    $rdp1.metadata.event_type = "NETWORK_CONNECTION"
    $rdp1.target.port = 3389
    $rdp1.target.ip = $pivot_ip
    not $rdp1.principal.ip in %global_allowed_mgmt_sources

    $rdp2.metadata.event_type = "NETWORK_CONNECTION"
    $rdp2.target.port = 3389
    $rdp2.principal.ip = $pivot_ip
    not $rdp2.principal.ip in %global_allowed_mgmt_sources
    not $rdp2.target.ip in %global_allowed_mgmt_sources

    $rdp1.principal.ip != $rdp2.target.ip
    $rdp1.metadata.event_timestamp.seconds <= $rdp2.metadata.event_timestamp.seconds

  match:
    $pivot_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1563")
    $primary_entity = array_distinct($pivot_ip)
    $first_hop_sources = array_distinct($rdp1.principal.ip)
    $second_hop_targets = array_distinct($rdp2.target.ip)
    $hop_count = count($rdp2.metadata.id)

  condition:
    $rdp1 and $rdp2
}
