/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:10:24.599366+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Network_Port_Knock_Sequence_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Network-side detection of a port-knocking pattern. One external source makes a small burst of connection attempts to several distinct, uncommon destination ports on a single destination within five minutes. This fits a knock sequence that opens a hidden listener. The upper bound on distinct ports separates it from broad port scans, which are a different behaviour. A single event cannot show a sequence, so this is a windowed threshold over one event type."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Requires perimeter firewall or network device connection logs, including denied or dropped attempts, normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated. If the firewall logs only accepted traffic, closed-port knocks are not visible."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and pen-test sources not yet in the allowlist, misconfigured clients retrying several ports, VoIP/SIP or P2P applications using dynamic ports, internet background noise from opportunistic scanners hitting a few ports, and legitimate port-knocking admin access to hardened management interfaces."
    tuning_guidance = "Add authorised scanning sources to %global_allowed_scanners and approved management or jump-host sources to %global_allowed_mgmt_sources. Raise or lower the distinct-port bounds in the condition to fit the environment's baseline noise. For internet-facing perimeters with heavy background scanning, raise the lower bound or add an alerting rule for follow-on successful connections to the same destination."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    $net.target.port > 0
    $net.target.port != 80
    $net.target.port != 443
    $net.target.port != 53
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  match:
    $src_ip, $dst_ip over 5m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($dst_ip)
    $source_ips = array_distinct($src_ip)
    $distinct_ports = count_distinct($net.target.port)
    $knocked_ports = array_distinct($net.target.port)
    $attempt_count = count($net.metadata.id)

  condition:
    $net and $distinct_ports >= 3 and $distinct_ports <= 10
}
