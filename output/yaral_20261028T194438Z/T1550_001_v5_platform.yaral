/*
  MITRE Technique : T1550.001 - Application Access Token
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:37:33.872421+00:00
  Reference       : https://attack.mitre.org/techniques/T1550/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1550_001_SaaS_Token_Auth_Scripted_Client {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a successful token-based sign-in (OAuth, bearer, access-token or refresh-token grant) to a SaaS application where the client identifies itself as a scripting or HTTP library rather than a browser or sanctioned application. This pattern indicates a stolen application access token being replayed from attacker tooling instead of a user authenticating interactively."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1550.001"
    mitre_technique_name = "Use Alternate Authentication Material: Application Access Token"
    log_prerequisites = "Identity provider or SaaS sign-in audit logs normalised to UDM USER_LOGIN, with extensions.auth.auth_details (grant or token type) and network.http.user_agent populated. No endpoint telemetry required."
    platform = "SaaS"
    log_source = "identity"
    false_positives = "Developers and integration engineers testing APIs with scripting libraries; unregistered automation or ETL jobs using OAuth tokens; backup, migration or reporting connectors that authenticate non-interactively; internal security testing."
    tuning_guidance = "Add known automation identities to %global_allowed_service_accounts, approved integration or application principals to %global_allowed_cloud_principals, and named administrators who script against the API to %global_allowed_admin_users. If a client's logs lack the auth_details field, confirm the identity parser maps the grant or token type there before deploying."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.auth_details = /(oauth|bearer|refresh[_ -]?token|access[_ -]?token|token[_ -]?(grant|exchange))/ nocase
    $auth.network.http.user_agent = /(python-requests|python-urllib|aiohttp|curl\/|wget\/|go-http-client|libwww-perl|okhttp|node-fetch|axios|java\/|apache-httpclient)/ nocase
    $auth.principal.user.userid != ""
    not $auth.principal.user.userid in %global_allowed_service_accounts
    not $auth.principal.user.userid in %global_allowed_cloud_principals
    not $auth.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1550.001")
    $primary_entity = array_distinct($auth.principal.user.userid)
    $source_ips = array_distinct($auth.principal.ip)
    $user_agents = array_distinct($auth.network.http.user_agent)
    $target_apps = array_distinct($auth.target.application)

  condition:
    $auth
}
