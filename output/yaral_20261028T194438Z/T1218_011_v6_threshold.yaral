/*
  MITRE Technique : T1218.011 - Rundll32
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:57:12.058997+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_011_Rundll32_Repeated_External_Connections {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects rundll32.exe making repeated outbound connections to external addresses from a single host within ten minutes. A single connection can be benign, but rundll32 is a proxy-execution binary that rarely initiates sustained external network traffic. Repeated connections suggest a DLL, script, or scriptlet payload beaconing or staging tools through rundll32. This rule uses network telemetry rather than command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.011"
    mitre_technique_name = "System Binary Proxy Execution: Rundll32"
    log_prerequisites = "Requires Windows endpoint network telemetry (EDR or Sysmon Event ID 3) that populates the initiating process path on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Shell extensions or control panel applets that contact the internet (for example cloud storage or printer drivers), WebDAV or network location access through shell32/davclnt, legacy installers and updaters that proxy through rundll32, and RMM or deployment tooling."
    tuning_guidance = "Add approved parent processes to %global_allowed_admin_tools, approved vendor or update domains to %global_allowed_domains, and scanner or test sources to %global_allowed_scanners. Raise the #net threshold on noisy hosts such as VDI or terminal servers. Review the destination and parent process outcome fields during triage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\rundll32\.exe$/ nocase
    $net.principal.hostname = $host
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($net.metadata.id)
    $mitre_technique_id = array_distinct("T1218.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $parent_processes = array_distinct($net.principal.process.parent_process.file.full_path)
    $users = array_distinct($net.principal.user.userid)

  condition:
    #net >= 3
}
