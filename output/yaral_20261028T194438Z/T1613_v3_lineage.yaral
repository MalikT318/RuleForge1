/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:35:19.067759+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_Container_Discovery_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects container or Kubernetes resource discovery (kubectl/docker/crictl listing commands, or direct calls to the Kubernetes API or container runtime socket) launched by an application-tier parent process such as a web server, application runtime or database service. These parents do not normally enumerate pods, nodes or containers, so this lineage suggests a compromised workload or web shell performing environment discovery."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires container runtime or node-level process telemetry (in-container PROCESS_LAUNCH events) with parent process path and full command line populated."
    platform = "Containers"
    log_source = "container"
    false_positives = "Health-check or readiness scripts run by an application runtime that query the Kubernetes API; CI/CD agents running on Java or Node runtimes that call kubectl or docker; operators or in-cluster controllers written in Python, Node or Java that list pods or nodes; monitoring sidecars using the runtime socket."
    tuning_guidance = "Add approved parent binaries (CI agents, operators, controllers) to %global_allowed_admin_tools or %global_allowed_script_hosts. Remove runtimes from the parent regex that legitimately query the cluster API in a given tenant, or scope them by adding the approved image's parent path to the allowlists."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|tomcat\d*|php-fpm\d*|php|node|java|python\d*|gunicorn|uwsgi|ruby|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|ash|zsh|kubectl|crictl|nerdctl|docker|podman|curl|wget|python\d*)$/ nocase
    $proc.target.process.command_line = /(\b(kubectl|crictl|nerdctl|docker|podman)\s+(-\S+\s+)*(get|describe|ps|images|ls|list|inspect|cluster-info|api-resources|top)\b|\/api\/v1\/(pods|nodes|namespaces|services|secrets)|\/apis\/apps\/v1\/(deployments|daemonsets|statefulsets)|\/containers\/json|docker\.sock|containerd\.sock|crio\.sock)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
