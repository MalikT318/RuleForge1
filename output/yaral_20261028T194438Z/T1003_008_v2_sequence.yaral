/*
  MITRE Technique : T1003.008 - /etc/passwd and /etc/shadow
  Tactic(s)       : Credential Access
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:50:27.450174+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_008_Shadow_Read_Then_Stage_In_Temp {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A non-system process reads /etc/shadow, and the same user then creates a file in a world-writable staging directory (/tmp, /var/tmp, /dev/shm) within 10 minutes on the same host. This pattern matches shadow-file dumping for offline cracking, for example a redirect into /tmp or a combined passwd/shadow file."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.008"
    mitre_technique_name = "OS Credential Dumping: /etc/passwd and /etc/shadow"
    log_prerequisites = "Requires Linux EDR or auditd file-access telemetry (watch rule on /etc/shadow) normalised to UDM FILE_READ, plus FILE_CREATION events with principal user and process populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Configuration management or compliance agents that audit shadow and write temp reports, password-quality auditing tools, admins running pwck or manual account maintenance, backup agents staging files in /tmp, and custom authentication helpers."
    tuning_guidance = "Add approved audit, backup, and automation binaries to %global_allowed_admin_tools, %global_allowed_backup_processes, or %global_allowed_security_tools. Add service accounts to %global_allowed_service_accounts. Extend the system-reader regex if a distribution-specific authentication daemon reads /etc/shadow."

  events:
    $read.metadata.event_type = "FILE_READ"
    $read.target.file.full_path = /^\/etc\/shadow-?$/
    not $read.principal.process.file.full_path = /\/(sshd|login|su|sudo|passwd|chpasswd|chage|unix_chkpwd|useradd|usermod|userdel|groupadd|vipw|pwck|grpck|systemd-logind|polkitd|crond?|gdm|lightdm|sssd|nscd)$/ nocase
    not $read.principal.process.file.full_path in %global_allowed_admin_tools
    not $read.principal.process.file.full_path in %global_allowed_backup_processes
    not $read.principal.process.file.full_path in %global_allowed_security_tools
    not $read.principal.user.userid in %global_allowed_service_accounts
    $read.principal.hostname = $hostname
    $read.principal.user.userid = $user

    $stage.metadata.event_type = "FILE_CREATION"
    $stage.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\//
    $stage.principal.process.file.full_path = /\/(bash|sh|dash|zsh|cat|cp|tee|head|tail|python[0-9.]*|perl)$/ nocase
    not $stage.principal.process.file.full_path in %global_allowed_admin_tools
    not $stage.principal.process.file.full_path in %global_allowed_backup_processes
    $stage.principal.hostname = $hostname
    $stage.principal.user.userid = $user

    $read.metadata.event_timestamp.seconds <= $stage.metadata.event_timestamp.seconds

  match:
    $hostname, $user over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1003.008")
    $primary_entity = array_distinct($hostname)
    $acting_user = array_distinct($user)
    $reader_processes = array_distinct($read.principal.process.file.full_path)
    $staged_files = array_distinct($stage.target.file.full_path)
    $staging_event_count = count($stage.metadata.id)

  condition:
    $read and $stage
}
