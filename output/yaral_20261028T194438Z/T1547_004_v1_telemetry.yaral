/*
  MITRE Technique : T1547.004 - Winlogon Helper DLL
  Tactic(s)       : Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:28:18.396192+00:00
  Reference       : https://attack.mitre.org/techniques/T1547/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1547_004_Winlogon_Helper_Registry_Modification {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a registry modification to Winlogon helper values (Shell, Userinit, Taskman, VmApplet, AppSetup) or anything under the Winlogon Notify subkey, where the written data is not the default Windows value. These changes make Winlogon load attacker-controlled executables or DLLs at logon. The rule detects the resulting registry state change and does not depend on command-line logging."
    mitre_tactic = "Persistence, Privilege Escalation"
    mitre_technique = "T1547.004"
    mitre_technique_name = "Boot or Logon Autostart Execution: Winlogon Helper DLL"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR registry events or Sysmon Event ID 12/13) that populates target.registry.registry_key and ideally registry_value_name and registry_value_data."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Enterprise shell replacement or kiosk configuration (custom Shell value), software deployment or imaging tools that legitimately append to Userinit, endpoint security products that register Winlogon notification components, and OS servicing or setup activity."
    tuning_guidance = "Add approved deployment, imaging, or configuration tools to %global_allowed_admin_tools and security agents to %global_allowed_security_tools. For managed kiosk estates, scope the custom Shell value to the affected hosts and extend the default-value exclusion regex accordingly. If registry_value_data is not populated by the client's EDR, the default-value exclusion will not match and the rule will alert on every write to these values, so validate this field during onboarding."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon(\\|$)/ nocase
    (
      $reg.target.registry.registry_value_name = /^(Shell|Userinit|Taskman|VmApplet|AppSetup)$/ nocase or
      $reg.target.registry.registry_key = /\\Winlogon\\Notify(\\|$)/ nocase
    )
    not $reg.target.registry.registry_value_data = /^((c:\\windows\\system32\\)?userinit\.exe,?|explorer\.exe)$/ nocase
    not $reg.principal.process.file.full_path = /\\TrustedInstaller\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1547.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $registry_value_data = array_distinct($reg.target.registry.registry_value_data)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modifying_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
