/*
  MITRE Technique : T1564.001 - Hidden Files and Directories
  Tactic(s)       : Stealth
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:13:20.245230+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_001_Linux_Hidden_File_In_World_Writable_Staging_Dir {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a hidden (dot-prefixed) file or a file inside a hidden (dot-prefixed) directory under world-writable staging locations (/tmp, /var/tmp, /dev/shm). Attackers use these locations to hide payloads, staged tools and loot from default directory listings. The rule works on the resulting file artifact, so it fires regardless of how the file was created (shell, script, compiled implant, or a renamed binary)."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.001"
    mitre_technique_name = "Hide Artifacts: Hidden Files and Directories"
    log_prerequisites = "Linux endpoint telemetry that emits file creation events with the full target path and the creating process (EDR file events or auditd PATH/SYSCALL records normalised to UDM FILE_CREATION)."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Desktop environments and X11/ICE/font sockets, browsers and Electron apps creating dot-prefixed temp directories, database and language runtime temp files (e.g. PostgreSQL sockets, editors' swap files such as .swp), package managers and build tools using hidden temp directories, configuration management and RMM agents staging files."
    tuning_guidance = "Add approved tooling that stages hidden files to %global_allowed_admin_tools (matched on the creating process path), and security agents to %global_allowed_security_tools. If a specific benign hidden temp pattern is noisy in a client environment, extend the named-exclusion regex. For servers with no interactive users, consider raising severity. Pair with a baseline review of hidden entries under /tmp, /var/tmp and /dev/shm per client."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/([^\/]+\/)*\.[^\/]+(\/|$)/ nocase
    not $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/\.(X11-unix|ICE-unix|font-unix|XIM-unix|Test-unix|X[0-9]+-lock|s\.PGSQL|esd-|dbus|mount_|com\.google\.Chrome|org\.chromium|org\.mozilla)/ nocase
    not $file.target.file.full_path = /\.(swp|swo|swx|lock)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(45)
    $mitre_technique_id = array_distinct("T1564.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $hidden_file_path = array_distinct($file.target.file.full_path)
    $creating_process = array_distinct($file.principal.process.file.full_path)
    $creating_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
