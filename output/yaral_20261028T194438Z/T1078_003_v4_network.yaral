/*
  MITRE Technique : T1078.003 - Local Accounts
  Tactic(s)       : Stealth, Persistence, Privilege Escalation, Initial Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Valid Accounts (incl. cloud)
  Target platform : Network Devices
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:32:59.819858+00:00
  Reference       : https://attack.mitre.org/techniques/T1078/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1078_003_NetDevice_External_Mgmt_Plane_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an external (non-RFC1918) source opening a connection to a network device management-plane service (SSH or Telnet). Local device accounts (admin, enable, console or break-glass users) are only usable if the management plane is reachable, so this is the network-side signal of local account abuse for initial access or persistence. It complements endpoint process rules by observing the connection itself."
    mitre_tactic = "Stealth, Persistence, Privilege Escalation, Initial Access"
    mitre_technique = "T1078.003"
    mitre_technique_name = "Valid Accounts: Local Accounts"
    log_prerequisites = "Requires firewall, router or switch connection logs, or flow records, normalised to UDM NETWORK_CONNECTION with principal.ip, target.port and target.hostname populated for traffic destined to network devices."
    platform = "Network Devices"
    log_source = "identity"
    false_positives = "Vendor or MSP remote support over the internet, administrators on VPN or mobile or home egress addresses not yet allowlisted, authorised external vulnerability scans, cloud-hosted network management or monitoring platforms, and CGNAT or NAT egress addresses of the corporate VPN."
    tuning_guidance = "Add approved management source addresses to %global_allowed_mgmt_sources and authorised scanner sources to %global_allowed_scanners. Confirm that the connection logs cover the management interfaces of the devices. Pair hits with device login success or failure events for the same target.hostname to prioritise triage."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    ($net.target.port = 22 or $net.target.port = 23)
    $net.principal.ip != ""
    $net.target.hostname != ""
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1078.003")
    $primary_entity = array_distinct($net.target.hostname)
    $source_ips = array_distinct($net.principal.ip)
    $target_ports = array_distinct($net.target.port)

  condition:
    $net
}
