/*
  MITRE Technique : T1218.014 - MMC
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:01:17.259643+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/014
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_014_MMC_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects mmc.exe (Microsoft Management Console) initiating an outbound connection to a non-internal address on SMB, HTTP/S, RPC or WinRM ports. MMC normally manages local or internal systems. External connections can indicate a remotely hosted malicious .msc console being fetched over SMB or WebDAV, or MMC proxying execution to attacker infrastructure. This is network-side coverage that complements command-line based detections."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.014"
    mitre_technique_name = "System Binary Proxy Execution: MMC"
    log_prerequisites = "Requires endpoint network telemetry that records the initiating process (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Certificate revocation (CRL/OCSP) or update checks triggered by snap-ins, admins managing cloud-hosted or remote-site servers through MMC snap-ins (Computer Management, Event Viewer, Services) over a VPN or public IP, Azure or Microsoft 365 admin snap-ins, and approved remote support sessions."
    tuning_guidance = "Add expected administrator accounts to %global_allowed_admin_users. Add known-good vendor and update domains to %global_allowed_domains. Ensure %rfc1918_internal covers the customer's internal address space. For customers with routine remote-site administration, narrow the port list or add approved admin hosts to the exclusions."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\mmc\.exe$/ nocase
    (
      $net.target.port = 445 or
      $net.target.port = 139 or
      $net.target.port = 135 or
      $net.target.port = 80 or
      $net.target.port = 443 or
      $net.target.port = 8080 or
      $net.target.port = 5985 or
      $net.target.port = 5986
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.user.userid in %global_allowed_admin_users
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.014")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)
    $mmc_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
