/*
  MITRE Technique : T1498 - Network Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:08:45.021317+00:00
  Reference       : https://attack.mitre.org/techniques/T1498
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1498_Linux_UDP_Reflection_Amplification_Inbound_Flow {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a single oversized inbound UDP flow from an external host whose source port is a well-known reflection/amplification service (DNS, NTP, SNMP, LDAP, SSDP, memcached, chargen, mDNS) toward an internal host such as a Linux server. Reflected or amplified traffic of this kind is characteristic of volumetric network denial of service (DDoS). Detection uses perimeter flow telemetry only and does not rely on endpoint process fields."
    mitre_tactic = "Impact"
    mitre_technique = "T1498"
    mitre_technique_name = "Network Denial of Service"
    log_prerequisites = "Requires firewall or perimeter flow logs normalized to NETWORK_FLOW with principal.ip, principal.port, target.ip, network.ip_protocol and network.sent_bytes populated (bytes sent by the external source toward the protected host). Sources should log flow records or session-end summaries, not only denied packets."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Legitimate large UDP transfers from external DNS resolvers, NTP or time servers, or LDAP/SNMP polling that exceed the byte threshold; large mDNS/SSDP exchanges across misrouted segments; bulk data replication or media streaming over UDP using these ports; authorised load or stress tests."
    tuning_guidance = "Raise or lower the network.sent_bytes threshold to match each client's normal UDP volume and flow-record aggregation interval. Add approved external sources to %global_allowed_scanners and trusted management or upstream sources to %global_allowed_mgmt_sources. Remove ports 53 and 123 from the port list if the client's upstream resolvers or time servers cause noise. Ensure %rfc1918_internal covers the client's internal ranges."

  events:
    $net.metadata.event_type = "NETWORK_FLOW"
    $net.network.ip_protocol = "UDP"
    (
      $net.principal.port = 53 or
      $net.principal.port = 19 or
      $net.principal.port = 123 or
      $net.principal.port = 161 or
      $net.principal.port = 389 or
      $net.principal.port = 1900 or
      $net.principal.port = 5353 or
      $net.principal.port = 11211
    )
    $net.network.sent_bytes > 20000000
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1498")
    $primary_entity = array_distinct($net.target.ip)
    $reflector_ips = array_distinct($net.principal.ip)
    $reflector_ports = array_distinct($net.principal.port)
    $max_flow_bytes = max($net.network.sent_bytes)

  condition:
    $net
}
