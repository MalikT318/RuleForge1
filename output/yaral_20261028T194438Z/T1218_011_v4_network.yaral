/*
  MITRE Technique : T1218.011 - Rundll32
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:56:41.062592+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_011_Rundll32_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects rundll32.exe initiating a network connection to a non-internal destination. Legitimate rundll32 usage is almost entirely local DLL export execution. Outbound connections from the process indicate proxy execution of a remote payload, a DLL that beacons to C2, or a script moniker pulling content from the internet. This is a network-side observation that does not depend on process command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.011"
    mitre_technique_name = "System Binary Proxy Execution: Rundll32"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that populates the initiating process path on NETWORK_CONNECTION events, plus the parent process path where available."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Windows shell and Control Panel components that legitimately reach Microsoft endpoints (e.g. network location awareness, OneDrive or shell extensions), VPN or SSO client helper DLLs run through rundll32, printer and driver installers, and software deployment agents."
    tuning_guidance = "Add approved parent process paths (RMM, deployment tools) to %global_allowed_admin_tools and endpoint agents to %global_allowed_security_tools. Add known-good vendor and update destinations to %global_allowed_domains. If the environment is noisy, restrict to hosts outside %global_allowed_script_hosts or raise severity only when the user is not in %global_allowed_admin_users."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\rundll32\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.parent_process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.011")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $destination_hosts = array_distinct($net.target.hostname)
    $user = array_distinct($net.principal.user.userid)
    $parent_process = array_distinct($net.principal.process.parent_process.file.full_path)

  condition:
    $net
}
