/*
  MITRE Technique : T1528 - Steal Application Access Token
  Tactic(s)       : Credential Access
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T13:28:15.595469+00:00
  Reference       : https://attack.mitre.org/techniques/T1528
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1528_OfficeSuite_OAuth_Consent_Grant_Token_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a user or admin consenting to an application, or an OAuth delegated permission or app role being granted, in Office Suite unified audit logs. Illicit consent grants give an attacker-controlled application a persistent access token to mailboxes, files and directory data without needing the user's password or MFA. The rule keys on the audit operation, not on app names, scopes or publisher values, so it still fires when the attacker changes the application or its hosting."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1528"
    mitre_technique_name = "Steal Application Access Token"
    log_prerequisites = "Office Suite unified audit logs (directory and identity audit operations, including application consent and permission grant events) ingested and normalised to UDM. The operation name must be populated in metadata.product_event_type."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate user or admin consent when onboarding sanctioned SaaS integrations; IT-led app registrations and enterprise application rollouts; security or migration tooling being authorised; developers granting permissions to internal test applications."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and automation identities or approved integration principals to %global_allowed_cloud_principals. If the volume of end-user consents is high, route the alerts to a review queue that checks the consented application and scopes."

  events:
    $cloud.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $cloud.metadata.product_event_type = /(consent to application|add delegated permission grant|add oauth2permissiongrant|add app role assignment grant)/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1528")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operation = array_distinct($cloud.metadata.product_event_type)
    $granted_resource = array_distinct($cloud.target.resource.name)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
