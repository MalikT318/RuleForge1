/*
  MITRE Technique : T1675 - ESXi Administration Command
  Tactic(s)       : Execution
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:21:04.325118+00:00
  Reference       : https://attack.mitre.org/techniques/T1675
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1675_ESXi_Guest_Operations_API_Execution {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects hypervisor guest-operations API calls (program start, process listing, file listing, file transfer to or from a guest) recorded in ESXi host management logs. These calls let an operator with management-plane credentials run commands inside guest VMs through the guest tools daemon, without any network path to the guest."
    mitre_tactic = "Execution"
    mitre_technique = "T1675"
    mitre_technique_name = "ESXi Administration Command"
    log_prerequisites = "ESXi hostd logs forwarded to Chronicle (syslog) and parsed so the guest operation name appears in metadata.description, security_result.summary or target.resource.name. Guest operations are logged by hostd at the default log level."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Backup and snapshot-quiescing software, VM provisioning and customization workflows, configuration management and patching orchestration, monitoring agents that poll guest process lists, and administrators running approved scripted guest maintenance."
    tuning_guidance = "Add automation and backup service accounts to %global_allowed_service_accounts, named administrators to %global_allowed_admin_users, and approved management or jump-host addresses to %global_allowed_mgmt_sources. If the client's parser puts the operation name in a different field, extend the field alternatives in the events block."

  events:
    $ops.metadata.event_type = "USER_RESOURCE_ACCESS"
    (
      $ops.metadata.description = /(StartProgramInGuest|ListProcessesInGuest|ListFilesInGuest|ListFileInGuest|InitiateFileTransferFromGuest|InitiateFileTransferToGuest|ReadEnvironmentVariableInGuest|TerminateProcessInGuest|CreateTemporaryFileInGuest|CreateTemporaryDirectoryInGuest)/ nocase or
      $ops.security_result.summary = /(StartProgramInGuest|ListProcessesInGuest|ListFilesInGuest|ListFileInGuest|InitiateFileTransferFromGuest|InitiateFileTransferToGuest|ReadEnvironmentVariableInGuest|TerminateProcessInGuest|CreateTemporaryFileInGuest|CreateTemporaryDirectoryInGuest)/ nocase or
      $ops.target.resource.name = /(StartProgramInGuest|ListProcessesInGuest|ListFilesInGuest|ListFileInGuest|InitiateFileTransferFromGuest|InitiateFileTransferToGuest|ReadEnvironmentVariableInGuest|TerminateProcessInGuest|CreateTemporaryFileInGuest|CreateTemporaryDirectoryInGuest)/ nocase
    )
    not $ops.principal.user.userid in %global_allowed_service_accounts
    not $ops.principal.user.userid in %global_allowed_admin_users
    not $ops.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1675")
    $primary_entity = array_distinct($ops.principal.hostname)
    $acting_users = array_distinct($ops.principal.user.userid)
    $source_ips = array_distinct($ops.principal.ip)
    $esxi_hosts = array_distinct($ops.target.hostname)

  condition:
    $ops
}
