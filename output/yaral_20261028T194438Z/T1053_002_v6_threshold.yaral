/*
  MITRE Technique : T1053.002 - At
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:13:40.074165+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_002_At_Job_File_Burst_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects several legacy At-style job files (At<N>.job) created in the Windows Tasks directory on a single host within one hour. A single job file can be routine, but repeated creation indicates bulk or repeated scheduling through the at utility or the Win32_ScheduledJob WMI class. This is file-artifact telemetry, not command-line matching, so it still fires if the at binary is renamed or the job is scheduled via WMI."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.002"
    mitre_technique_name = "Scheduled Task/Job: At"
    log_prerequisites = "Requires EDR or Sysmon file-creation telemetry covering the Windows Tasks directory (Sysmon Event ID 11 or equivalent)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legacy line-of-business or batch software that still schedules jobs through the at interface, RMM or deployment tooling, and admins migrating old scheduled jobs."
    tuning_guidance = "Add approved scheduling tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #file threshold on hosts with known legacy batch workloads. Severity scales through $risk_score in outcome."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\windows\\tasks\\at\d+\.job$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 1h

  outcome:
    $risk_score = max(if($file.principal.process.file.full_path = /\\(at|wmic|cmd|powershell|pwsh|wscript|cscript)\.exe$/ nocase, 80, 60))
    $event_count = count($file.metadata.id)
    $job_files = array_distinct($file.target.file.full_path)
    $users = array_distinct($file.principal.user.userid)
    $mitre_technique_id = array_distinct("T1053.002")
    $primary_entity = array_distinct($host)

  condition:
    #file >= 3
}
