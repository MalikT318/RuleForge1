/*
  MITRE Technique : T1555.003 - Credentials from Web Browsers
  Tactic(s)       : Credential Access
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:56:04.648168+00:00
  Reference       : https://attack.mitre.org/techniques/T1555/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1555_003_Server_Process_Spawns_Browser_Credential_Access {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a web server, application server or database service process spawning a shell, script interpreter or SQLite client whose command line touches a browser credential store (Chrome/Chromium/Brave/Edge/Opera Login Data, Firefox logins.json/key4.db/signons.sqlite, cookies databases). Server-side daemons have no legitimate reason to read end-user browser profiles, so this lineage strongly suggests a web shell, injected service or compromised application harvesting saved credentials."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1555.003"
    mitre_technique_name = "Credentials from Password Stores: Credentials from Web Browsers"
    log_prerequisites = "Requires Linux EDR or auditd EXECVE/SYSCALL process telemetry that populates parent process path, child process path and child command line."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developer or test servers where a web or application service legitimately runs browser automation or profile-backup scripts; headless-browser testing frameworks launched from Node/Java services; admin troubleshooting through a service-owned shell; backup or forensic scripts launched from a database or application service."
    tuning_guidance = "Add approved parent processes or script hosts to %global_allowed_script_hosts, and sanctioned EDR/security agents to %global_allowed_security_tools. Add sanctioned automation tooling to %global_allowed_admin_tools. If headless-browser automation is common on a client, remove node/java from the parent regex for that client or allowlist the parent path."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(nginx|apache2|httpd|lighttpd|caddy|php-fpm[0-9.]*|php[0-9.]*|tomcat[0-9]*|java|node|gunicorn|uwsgi|mysqld|mariadbd|postgres|mongod|redis-server)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|ksh|python[0-9.]*|perl|ruby|php[0-9.]*|sqlite3?)$/ nocase
    $proc.target.process.command_line = /(Login.{0,2}Data|logins\.json|key[34]\.db|signons\.sqlite|cookies\.sqlite|\.config\/(google-chrome|chromium|BraveSoftware|microsoft-edge|opera)|\.mozilla\/firefox|snap\/(chromium|firefox)\/common)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1555.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
