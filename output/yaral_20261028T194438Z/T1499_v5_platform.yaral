/*
  MITRE Technique : T1499 - Endpoint Denial of Service
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:15:30.318003+00:00
  Reference       : https://attack.mitre.org/techniques/T1499
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_Container_Resource_Guardrail_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects deletion of Kubernetes ResourceQuota or LimitRange objects through the cluster control plane audit log. These objects cap CPU, memory and object counts per namespace. Removing them lets a workload exhaust node resources and starve co-located services, which is a precursor to or enabler of endpoint denial of service in containerised environments. This is a control-plane detection and does not rely on in-container process command lines."
    mitre_tactic = "Impact"
    mitre_technique = "T1499"
    mitre_technique_name = "Endpoint Denial of Service"
    log_prerequisites = "Requires Kubernetes API server audit logs (managed or self-hosted) ingested into Chronicle and normalised to RESOURCE_DELETION, with the resource path populated in target.resource.name and the API verb in metadata.product_event_type."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Platform teams re-baselining namespace quotas, GitOps controllers recreating quota objects, namespace teardown by automation, CI/CD ephemeral environment cleanup, multi-tenant onboarding and offboarding tooling."
    tuning_guidance = "Add approved platform engineers to %global_allowed_admin_users, GitOps and CI/CD identities to %global_allowed_service_accounts, and approved automation principals to %global_allowed_cloud_principals. Namespace controller garbage collection is already excluded. If product_event_type is not populated with the API verb for a client, tune the delete filter to that client's field."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.target.resource.name = /(^|[\/.])(resourcequotas|limitranges)([\/.]|$)/ nocase
    $cloud.metadata.product_event_type = /delete/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid = /^system:serviceaccount:kube-system:(namespace|resourcequota|generic-garbage-collector)[a-z-]*$/ nocase
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1499")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $deleted_resource = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
