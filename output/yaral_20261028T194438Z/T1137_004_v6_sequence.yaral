/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:19:38.805682+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_Home_Page_Set_After_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a mailbox folder home page (WebViewInfo) setting being modified by a user within ten minutes of an external-source login. Adversaries abuse the legacy Outlook Home Page feature to load a malicious HTML page, which gives them persistence and code execution whenever the folder is opened. A pairing of external login and home page change is rare in normal use."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires unified audit logs with Exchange mailbox and admin audit events (folder property and setting changes) plus Entra ID sign-in events, ingested and normalized to UDM. Mailbox auditing must be enabled for the Update and Set-MailboxFolder operations."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate users or help desk staff setting a folder home page for a business dashboard or legacy intranet, usually after a VPN or travel login. Migration tooling and mailbox provisioning scripts. Administrators making delegated folder changes."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users. Add automation and migration accounts to %global_allowed_service_accounts. Add trusted egress or VPN ranges to %rfc1918_internal if the tenant stores them as plain strings. If the folder property name differs in the client's normalized logs, adjust the target.resource.name regex in the setting event."

  events:
    $login.metadata.event_type = "USER_LOGIN"
    $login.principal.user.userid = $user
    not $login.principal.ip in %rfc1918_internal
    not $login.principal.user.userid in %global_allowed_service_accounts

    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.principal.user.userid = $user
    $setting.target.resource.name = /(webview|home[_\s-]?page)/ nocase
    $setting.metadata.product_event_type = /(Set-MailboxFolder|Update|SetFolder|MailboxFolder)/ nocase
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts

    $login.metadata.event_timestamp.seconds <= $setting.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($user)
    $login_source_ips = array_distinct($login.principal.ip)
    $modified_settings = array_distinct($setting.target.resource.name)
    $setting_operations = array_distinct($setting.metadata.product_event_type)
    $first_login_time = min($login.metadata.event_timestamp.seconds)
    $last_setting_time = max($setting.metadata.event_timestamp.seconds)

  condition:
    $login and $setting
}
