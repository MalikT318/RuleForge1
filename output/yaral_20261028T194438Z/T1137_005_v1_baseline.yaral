/*
  MITRE Technique : T1137.005 - Outlook Rules
  Tactic(s)       : Persistence
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:20:24.377024+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_005_Mailbox_Rule_Application_Execution_Action {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation or modification of a mailbox inbox rule whose definition contains a run-application or start-process action, or an executable or script target on a local or UNC path. Outlook rules with these actions trigger code execution when a crafted message arrives, giving the adversary persistence. Ordinary rules only move, flag, label or forward mail and never launch programs, so this signal is high fidelity."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.005"
    mitre_technique_name = "Office Application Startup: Outlook Rules"
    log_prerequisites = "Requires unified audit log ingestion with mailbox audit and admin audit events enabled, including inbox rule operations (New-InboxRule, Set-InboxRule, UpdateInboxRules). The parser must populate metadata.product_event_type with the operation name and expose the rule parameters in target.resource.attribute.labels or security_result.description."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legacy line-of-business mail automation that deliberately launches a local helper application, and administrators migrating or restoring rules from older mail clients. Rules that match on an attachment or subject containing an executable file name can also match the script/executable pattern."
    tuning_guidance = "Add approved automation and migration accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. If a client has legitimate rule-driven application launches, scope the exclusion by account rather than loosening the regex. Confirm during onboarding which UDM field carries rule parameters in the client's parser and adjust the field reference if needed."

  events:
    $audit.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    $audit.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules)$/ nocase
    (
      $audit.target.resource.attribute.labels.value = /((start|run)[-_ ]?(application|process)|\\\\[a-z0-9._-]+\\[^\s"']+\.(exe|bat|cmd|ps1|vbs|hta|dll|scr))/ nocase or
      $audit.security_result.description = /((start|run)[-_ ]?(application|process)|\\\\[a-z0-9._-]+\\[^\s"']+\.(exe|bat|cmd|ps1|vbs|hta|dll|scr))/ nocase
    )
    not $audit.principal.user.userid in %global_allowed_service_accounts
    not $audit.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1137.005")
    $primary_entity = array_distinct($audit.principal.user.userid)
    $rule_operation = array_distinct($audit.metadata.product_event_type)
    $source_ips = array_distinct($audit.principal.ip)
    $affected_mailbox = array_distinct($audit.target.user.userid)

  condition:
    $audit
}
