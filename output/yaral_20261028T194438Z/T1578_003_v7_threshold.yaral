/*
  MITRE Technique : T1578.003 - Delete Cloud Instance
  Tactic(s)       : Defense Impairment
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : IaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:54:05.561522+00:00
  Reference       : https://attack.mitre.org/techniques/T1578/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1578_003_Mass_Cloud_Instance_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "A single identity deleted or terminated several cloud compute instances or virtual machines within ten minutes. Each deletion is routine alone, but a burst from one principal can indicate an adversary destroying forensic evidence after malicious activity, or terminating attacker-created instances."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1578.003"
    mitre_technique_name = "Modify Cloud Compute Infrastructure: Delete Cloud Instance"
    log_prerequisites = "Cloud control-plane audit logging (management/activity logs for compute APIs) ingested and normalised to UDM RESOURCE_DELETION events with principal.user.userid and metadata.product_event_type populated."
    platform = "IaaS"
    log_source = "cloud_audit"
    false_positives = "Autoscaling groups and managed instance groups scaling in, CI/CD and infrastructure-as-code pipelines tearing down ephemeral environments, spot or preemptible fleet recycling, scheduled cost-saving clean-up jobs, and decommissioning projects run by cloud administrators."
    tuning_guidance = "Add automation and pipeline identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named cloud administrators to %global_allowed_admin_users. The default threshold is 5 deletions per principal in 10 minutes. Raise it for tenants with heavy ephemeral workloads, or lower it to 3 for high-sensitivity production accounts. Review $destination_resources and $source_ips in the outcome to triage."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.metadata.product_event_type = /(?i)(terminate|delete|destroy|deallocate).*(instance|virtualmachine|virtual_machine|vm)/
    $cloud.principal.user.userid = $user
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_cloud_principals
    not $cloud.principal.user.userid in %global_allowed_admin_users

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $event_count = count($cloud.metadata.id)
    $mitre_technique_id = array_distinct("T1578.003")
    $primary_entity = array_distinct($user)
    $destination_resources = array_distinct($cloud.target.resource.name)
    $source_ips = array_distinct($cloud.principal.ip)
    $api_calls = array_distinct($cloud.metadata.product_event_type)

  condition:
    #cloud >= 5
}
