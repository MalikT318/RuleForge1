/*
  MITRE Technique : T1137.004 - Outlook Home Page
  Tactic(s)       : Persistence
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:19:19.445399+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_004_Outlook_Home_Page_Registry_Persistence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects registry modification of Outlook folder home page (WebView) URL values or the roaming folder homepage security setting by a process other than a trusted installer or admin tool. Outlook Home Page is a Windows-only Outlook feature (no Linux, macOS or cloud equivalent exists), so this rule targets the Windows registry mechanism."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.004"
    mitre_technique_name = "Office Application Startup: Outlook Home Page"
    log_prerequisites = "Requires Windows registry modification telemetry from an EDR or Sysmon (registry events, Sysmon Event ID 13), with key path, value name and initiating process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office or Click-to-Run updates and repairs, Group Policy or Intune configuration changes to Outlook security settings, software deployment tools, legitimate Outlook add-ins that configure folder home pages."
    tuning_guidance = "Add approved deployment and configuration tooling to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. If the environment legitimately uses folder home pages, scope exclusions by initiating process, not by registry path."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\(Policies\\)?Microsoft\\Office\\[0-9.]+\\Outlook\\(WebView|Security)/ nocase
    $reg.target.registry.registry_value_name = /^(URL|EnableRoamingFolderHomepages|NonDefaultStoreOnly)$/ nocase
    not $reg.principal.process.file.full_path = /\\(OfficeClickToRun|OfficeC2RClient|msiexec|TrustedInstaller)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1137.004")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $registry_value_name = array_distinct($reg.target.registry.registry_value_name)
    $initiating_process = array_distinct($reg.principal.process.file.full_path)
    $user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
