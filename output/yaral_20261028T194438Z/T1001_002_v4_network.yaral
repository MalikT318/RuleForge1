/*
  MITRE Technique : T1001.002 - Steganography
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:08:24.364820+00:00
  Reference       : https://attack.mitre.org/techniques/T1001/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_002_ESXi_Host_External_Image_Download {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "An ESXi host performs an outbound HTTP request for an image file (jpg, png, gif, bmp, ico, webp, tiff) on an external, non-allowlisted destination. ESXi hosts have no browser or normal need to fetch images from the internet, and their legitimate outbound HTTP is limited to patch, VIB and vendor update traffic. Image fetches from the hypervisor shell are consistent with steganographic C2, where commands or payloads are hidden in image files served by an attacker-controlled web host."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001.002"
    mitre_technique_name = "Data Obfuscation: Steganography"
    log_prerequisites = "Requires ESXi outbound HTTP telemetry normalised to NETWORK_HTTP with target.url populated. This can come from a network sensor, proxy or firewall that sees the host's management or VMkernel egress, or from forwarded ESXi shell and hostd logs. principal.hostname must identify the ESXi host."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Administrators fetching logos or branding images for custom host UI or welcome banners; vendor or hardware-management agents downloading icons or images from vendor CDNs not yet in the allowlist; internal mirrors or depots hosted on public address space; authorised scanners or testing sources."
    tuning_guidance = "Add known-good vendor and update domains to %global_allowed_domains. Add approved administrative tooling to %global_allowed_admin_tools. Add authorised scanning or testing sources to %global_allowed_scanners. If the tenant proxies ESXi egress, make sure the proxy logs preserve the original ESXi host as principal.hostname. Consider raising severity for hosts with no history of any outbound HTTP."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.hostname != ""
    $http.target.url = /\.(jpe?g|png|gif|bmp|ico|webp|tiff?)(\?.*)?$/ nocase
    not $http.network.http.method = /^(POST|PUT)$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.process.file.full_path in %global_allowed_admin_tools
    not $http.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1001.002")
    $primary_entity = array_distinct($http.principal.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $requested_urls = array_distinct($http.target.url)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    $http
}
