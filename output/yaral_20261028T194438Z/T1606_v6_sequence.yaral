/*
  MITRE Technique : T1606 - Forge Web Credentials
  Tactic(s)       : Credential Access
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:22:36.867255+00:00
  Reference       : https://attack.mitre.org/techniques/T1606
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1606_Privilege_Grant_Then_External_SSO_Login {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A privileged or federation-related role is granted to an identity, and that same identity then completes a single sign-on login from an external address within ten minutes. This pattern can indicate forged web credentials, where an adversary with directory or federation control mints access and uses it at once. The rule uses only identity-provider telemetry from a Windows directory and federation environment."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1606"
    mitre_technique_name = "Forge Web Credentials"
    log_prerequisites = "Requires identity provider directory audit logs (permission and role changes) and sign-in logs, normalised to UDM USER_CHANGE_PERMISSIONS and USER_LOGIN, with extensions.auth.type populated for SSO sign-ins."
    platform = "Windows"
    log_source = "identity"
    false_positives = "Legitimate onboarding or just-in-time privilege elevation followed by an off-network SSO login, administrators working remotely, and automated role-assignment workflows."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users, automation identities to %global_allowed_service_accounts, and scale the role-name regex to local naming conventions. If your identity provider does not populate extensions.auth.type, remove that condition and tighten the role filter instead."

  events:
    $perm.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $perm.target.user.attribute.roles.name = /(admin|federat|token|signing|certificate|global|privileged)/ nocase
    not $perm.principal.user.userid in %global_allowed_admin_users
    $perm.target.user.userid = $user

    $login.metadata.event_type = "USER_LOGIN"
    $login.extensions.auth.type = "SSO"
    not $login.principal.ip in %rfc1918_internal
    not $login.target.user.userid in %global_allowed_service_accounts
    $login.target.user.userid = $user

    $perm.metadata.event_timestamp.seconds <= $login.metadata.event_timestamp.seconds

  match:
    $user over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1606")
    $primary_entity = array_distinct($user)
    $granting_actors = array_distinct($perm.principal.user.userid)
    $granted_roles = array_distinct($perm.target.user.attribute.roles.name)
    $login_source_ips = array_distinct($login.principal.ip)
    $login_count = count($login.metadata.id)

  condition:
    $perm and $login
}
