/*
  MITRE Technique : T1560 - Archive Collected Data
  Tactic(s)       : Collection
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T15:57:02.022942+00:00
  Reference       : https://attack.mitre.org/techniques/T1560
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1560_Linux_Archive_Staging_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of archive or encrypted-container files (tar, gz, zip, 7z, rar, xz, bz2, gpg and similar) created in common Linux staging locations (/tmp, /var/tmp, /dev/shm, /root, home directories) on a single host within 10 minutes. One archive is routine, but several in a short window indicates collected data being compressed or encrypted ahead of exfiltration. This rule uses file-creation volume rather than process command lines, so it also catches custom or renamed archiving tools and library-based compression."
    mitre_tactic = "Collection"
    mitre_technique = "T1560"
    mitre_technique_name = "Archive Collected Data"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-creation records normalised to UDM FILE_CREATION with target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Backup and imaging jobs writing archives to /tmp or home directories, developers building release tarballs, package or build pipelines, log collection scripts for support cases, and CI runners."
    tuning_guidance = "Add backup agents to %global_allowed_backup_processes, deployment and build tooling to %global_allowed_admin_tools, and automation accounts to %global_allowed_service_accounts. Raise the #file threshold for build servers. Narrow the staging-directory regex if home directories are noisy."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|root|home\/[^\/]+)\/.*\.(tar|tar\.gz|tgz|tar\.bz2|tbz2|tar\.xz|txz|zip|7z|rar|gz|bz2|xz|zst|gpg|enc|pgp)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|snapd|packagekitd)$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if(re.regex($file.target.file.full_path, /(?i)\.(gpg|pgp|enc|7z|rar)$/), 80, 60))
    $event_count = count($file.metadata.id)
    $mitre_technique_id = array_distinct("T1560")
    $primary_entity = array_distinct($host)
    $users = array_distinct($file.principal.user.userid)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $archive_paths = array_distinct($file.target.file.full_path)

  condition:
    #file >= 5
}
