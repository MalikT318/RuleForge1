/*
  MITRE Technique : T1059.012 - Hypervisor CLI
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:24:22.578256+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_012_ESXi_Hypervisor_CLI_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a hypervisor management CLI (esxcli, localcli, vim-cmd, vimsh) launched by a parent process that does not normally invoke it on an ESXi host. Unexpected parents include script interpreters, network listeners and relays, and web or CIM management daemons. This pattern points to a web shell, a reverse shell, an exploited management service, or a dropped script driving the hypervisor CLI. The rule keys on process lineage only and does not inspect command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.012"
    mitre_technique_name = "Command and Scripting Interpreter: Hypervisor CLI"
    log_prerequisites = "ESXi shell and process execution events forwarded and parsed into UDM PROCESS_LAUNCH with both the parent (principal.process) and child (target.process) executable paths populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Vendor or in-house Python or Perl maintenance and health-check scripts that call esxcli or vim-cmd. Backup, monitoring or patching agents that wrap the CLI through an interpreter. Management daemons that legitimately shell out during host operations. Admin automation frameworks such as PowerCLI helper scripts or kickstart post-install scripts."
    tuning_guidance = "Add approved interpreter or wrapper parent paths to %global_allowed_script_hosts. Add approved management or monitoring binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Review first-seen parent paths per host before adding exclusions, and extend the parent regex only with daemons confirmed never to invoke the CLI in your environment."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /(^|\/)(esxcli|localcli|vim-cmd|vimsh)$/ nocase
    $proc.principal.process.file.full_path = /\/(python[0-9.]*|perl|nc|ncat|socat|rhttpproxy|openwsman|sfcbd|sfcb-[a-z0-9_\-]+|lighttpd|nginx|httpd)$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.012")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
