/*
  MITRE Technique : T1486 - Data Encrypted for Impact
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Data Encrypted for Impact / Cloud Theft
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:01:42.442306+00:00
  Reference       : https://attack.mitre.org/techniques/T1486
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1486_ESXi_Unsigned_Binary_Execution_Setting_Changed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a change to the ESXi kernel boot option that restricts execution to installed, signed binaries (execInstalledOnly). Ransomware operators disable this control so that an unsigned encryptor can run from a datastore or temp path and encrypt VM disk and configuration files. This is a configuration-plane pre-encryption indicator that complements existing process command-line coverage."
    mitre_tactic = "Impact"
    mitre_technique = "T1486"
    mitre_technique_name = "Data Encrypted for Impact"
    log_prerequisites = "ESXi hostd/shell syslog forwarded to Chronicle and parsed into SETTING_MODIFICATION events with the advanced setting name in target.resource.name or security_result.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Authorised administrators toggling the option for troubleshooting or installing unsigned third-party VIBs or drivers; host profile or configuration-management remediation; lab and test hosts."
    tuning_guidance = "Add approved administrator accounts to %global_allowed_admin_users and approved management or automation source addresses to %global_allowed_mgmt_sources. Treat any change outside a change window as suspicious, and pivot on SSH logins and datastore file activity on the same host."

  events:
    $cfg.metadata.event_type = "SETTING_MODIFICATION"
    (
      $cfg.target.resource.name = /execInstalledOnly/ nocase or
      $cfg.security_result.description = /execInstalledOnly/ nocase
    )
    not $cfg.principal.user.userid in %global_allowed_admin_users
    not $cfg.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1486")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $acting_user = array_distinct($cfg.principal.user.userid)
    $source_ips = array_distinct($cfg.principal.ip)

  condition:
    $cfg
}
