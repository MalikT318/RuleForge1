/*
  MITRE Technique : T1565.003 - Runtime Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:44:06.010627+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_003_File_Association_Handler_Hijack_Windows {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of the shell open command for a document or data-viewer file class (text, CSV, Office, PDF, HTML) so that it launches a script interpreter, LOLBin, or a binary in a user-writable location. This is a file-association hijack that lets an adversary alter or intercept data as it is opened and displayed to the user (runtime data manipulation)."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.003"
    mitre_technique_name = "Data Manipulation: Runtime Data Manipulation"
    log_prerequisites = "Requires Windows registry modification telemetry that includes registry key and value data (EDR or Sysmon Event ID 13), with the writing process populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application installers and updaters that legitimately register document handlers (PDF readers, Office, text editors, browsers), software deployment tooling, and users who set a portable editor as the default viewer."
    tuning_guidance = "Add approved deployment and packaging tools to %global_allowed_admin_tools and endpoint security agents to %global_allowed_security_tools. If a client has an approved portable viewer, exclude it by executable name. Extend the file class list for business-specific data viewers."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\Software\\Classes\\(txtfile|inffile|csvfile|htmlfile|Excel\.(Sheet|CSV|SheetMacroEnabled)(\.\d+)?|Word\.Document(\.\d+)?|AcroExch\.Document(\.DC)?|Applications\\[^\\]+)\\shell\\(open|edit|print)\\command$/ nocase
    $reg.target.registry.registry_value_data = /(\b(powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32|msbuild|certutil|bitsadmin)(\.exe)?\b|\\users\\[^\\]+\\appdata\\|\\programdata\\|\\windows\\temp\\|\\users\\public\\|\\temp\\)/ nocase
    not $reg.principal.process.file.full_path = /\\(msiexec|TrustedInstaller|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_security_tools

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1565.003")
    $primary_entity = array_distinct($reg.principal.hostname)
    $registry_key = array_distinct($reg.target.registry.registry_key)
    $handler_command = array_distinct($reg.target.registry.registry_value_data)
    $writer_process = array_distinct($reg.principal.process.file.full_path)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
