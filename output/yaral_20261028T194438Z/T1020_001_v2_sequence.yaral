/*
  MITRE Technique : T1020.001 - Traffic Duplication
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:31:37.766547+00:00
  Reference       : https://attack.mitre.org/techniques/T1020/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1020_001_Mgmt_Access_Then_Tunnel_Mirror_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a network device receiving a management-plane connection (SSH, Telnet or NETCONF) from a source outside the approved management list, followed within ten minutes by that same device originating GRE/ERSPAN or VXLAN-encapsulated flows to an external destination. This pattern is consistent with an adversary configuring traffic mirroring and forwarding duplicated traffic to infrastructure they control."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1020.001"
    mitre_technique_name = "Automated Exfiltration: Traffic Duplication"
    log_prerequisites = "Requires firewall, perimeter or flow records that include the network device's own management-plane connections and device-originated flows, with principal.ip, target.ip, target.port and network.ip_protocol populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legitimate ERSPAN/GRE/VXLAN tunnels to external or cloud-hosted network monitoring or packet-broker services; SD-WAN or overlay VPN tunnels originated by the device; engineers on non-allow-listed jump hosts or VPN pools doing planned maintenance."
    tuning_guidance = "Add approved admin jump hosts and management subnets' addresses to %global_allowed_mgmt_sources. Add known-good monitoring or overlay vendor hostnames to %global_allowed_domains. If SD-WAN overlays legitimately use VXLAN or GRE to external peers, scope them out by adding those peers' hostnames to %global_allowed_domains or by extending the destination exclusions."

  events:
    $mgmt.metadata.event_type = "NETWORK_CONNECTION"
    (
      $mgmt.target.port = 22 or
      $mgmt.target.port = 23 or
      $mgmt.target.port = 830
    )
    not $mgmt.principal.ip in %global_allowed_mgmt_sources
    $mgmt.target.ip = $device_ip

    $mirror.metadata.event_type = "NETWORK_FLOW"
    (
      $mirror.network.ip_protocol = "GRE" or
      ($mirror.network.ip_protocol = "UDP" and $mirror.target.port = 4789)
    )
    not $mirror.target.ip in %rfc1918_internal
    not $mirror.target.hostname in %global_allowed_domains
    $mirror.principal.ip = $device_ip

    $mgmt.metadata.event_timestamp.seconds <= $mirror.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1020.001")
    $primary_entity = array_distinct($device_ip)
    $mgmt_source_ips = array_distinct($mgmt.principal.ip)
    $mirror_destination_ips = array_distinct($mirror.target.ip)
    $mirror_flow_count = count($mirror.metadata.id)

  condition:
    $mgmt and $mirror
}
