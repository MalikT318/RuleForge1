/*
  MITRE Technique : T1218.008 - Odbcconf
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:52:27.237701+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_008_Odbcconf_Anomalous_Module_Loads {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects odbcconf.exe loading several DLL modules from outside the standard Windows system directories within ten minutes on a single host. A single module load is routine for ODBC driver configuration. Repeated loads of non-system modules indicate REGSVR or driver-registration abuse used to proxy DLL execution. This detection is based on module-load telemetry rather than command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.008"
    mitre_technique_name = "System Binary Proxy Execution: Odbcconf"
    log_prerequisites = "Requires EDR or Sysmon image/module-load telemetry (Sysmon Event ID 7 or equivalent) normalised to PROCESS_MODULE_LOAD with principal.process and target.file populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Installers or database client deployments that register third-party ODBC drivers (for example SQL Server, Oracle or PostgreSQL client drivers) from Program Files. Software packaging and RMM jobs that configure DSNs in bulk. Application onboarding by DBAs."
    tuning_guidance = "Add approved deployment or packaging parent processes to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #mod threshold if driver installs are common in the environment. Review the modules array_distinct output for user-writable paths (Users, Temp, ProgramData, Public) to prioritise triage."

  events:
    $mod.metadata.event_type = "PROCESS_MODULE_LOAD"
    $mod.principal.process.file.full_path = /\\odbcconf\.exe$/ nocase
    $mod.target.file.full_path = /\.(dll|ocx)$/ nocase
    not $mod.target.file.full_path = /^[a-z]:\\windows\\(system32|syswow64|winsxs)\\/ nocase
    not $mod.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.user.userid in %global_allowed_service_accounts
    $mod.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.008")
    $primary_entity = array_distinct($mod.principal.hostname)
    $module_count = count($mod.metadata.id)
    $loaded_modules = array_distinct($mod.target.file.full_path)
    $users = array_distinct($mod.principal.user.userid)

  condition:
    #mod >= 3
}
