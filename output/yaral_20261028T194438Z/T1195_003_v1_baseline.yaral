/*
  MITRE Technique : T1195.003 - Compromise Hardware Supply Chain
  Tactic(s)       : Initial Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:43:53.515345+00:00
  Reference       : https://attack.mitre.org/techniques/T1195/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1195_003_Linux_Firmware_Flash_Write_From_OS {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Linux process that writes firmware or flash images from within the running OS: SPI/BIOS flash writes, MTD device writes, or firmware-update installs. This is the host-visible result of hardware or firmware tampering associated with supply-chain compromise, such as a backdoored BIOS, BMC, or option ROM being implanted or re-flashed on a newly deployed or serviced system. It does not detect tampering done before delivery."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1195.003"
    mitre_technique_name = "Supply Chain Compromise: Compromise Hardware Supply Chain"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd EXECVE records normalised to UDM PROCESS_LAUNCH with populated command_line and parent process path."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Legitimate BIOS/UEFI/BMC/NIC firmware updates by IT or hardware vendors, fwupd-driven updates from software centres or patch automation, embedded or router-style Linux devices that flash MTD partitions during upgrades, and hardware provisioning or imaging pipelines."
    tuning_guidance = "Add approved firmware update tooling and patch-automation parent processes to %global_allowed_admin_tools. Add provisioning or patch service accounts to %global_allowed_service_accounts, and named firmware administrators to %global_allowed_admin_users. Enable first in alert-only mode on newly commissioned hosts and tune against maintenance windows."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.command_line = /(\bflashrom\b.*(\s-w\b|\s--write\b)|\b(flashcp|nandwrite)\b.*\/dev\/mtd|\bmtd_debug\s+write\b|\bdd\b.*\bof=\/dev\/mtd|\bfwupd(mgr|tool)\b.*\b(install|install-blob|local-install)\b)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts
    not $proc.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1195.003")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
