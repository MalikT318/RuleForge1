/*
  MITRE Technique : T1602.002 - Network Device Configuration Dump
  Tactic(s)       : Collection
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:20:49.038581+00:00
  Reference       : https://attack.mitre.org/techniques/T1602/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1602_002_Mgmt_Protocol_Access_Then_Device_Config_Export {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects an unapproved source reaching a network device on a configuration-retrieval management port (SNMP or Smart Install), followed within ten minutes by that same device initiating an outbound TFTP or FTP transfer to an unapproved destination. This sequence is consistent with a configuration dump being staged or exported."
    mitre_tactic = "Collection"
    mitre_technique = "T1602.002"
    mitre_technique_name = "Data from Configuration Repository: Network Device Configuration Dump"
    log_prerequisites = "Requires firewall or perimeter connection logs that record the device management-plane address as target.ip (inbound) and principal.ip (outbound), with destination ports populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Network management or monitoring platforms not yet in the management-source list; scheduled configuration backup jobs to a TFTP or FTP server; authorised vulnerability scanners; admins performing manual configuration backups or firmware staging."
    tuning_guidance = "Add approved NMS, jump hosts and backup servers to %global_allowed_mgmt_sources. Add authorised scanning sources to %global_allowed_scanners. If SNMP polling is noisy, narrow the inbound port to 4786 only."

  events:
    $inbound.metadata.event_type = "NETWORK_CONNECTION"
    ($inbound.target.port = 4786 or $inbound.target.port = 161)
    not $inbound.principal.ip in %global_allowed_mgmt_sources
    not $inbound.principal.ip in %global_allowed_scanners
    $inbound.target.ip = $device_ip

    $outbound.metadata.event_type = "NETWORK_CONNECTION"
    ($outbound.target.port = 69 or $outbound.target.port = 21)
    not $outbound.target.ip in %global_allowed_mgmt_sources
    $outbound.principal.ip = $device_ip

    $inbound.metadata.event_timestamp.seconds <= $outbound.metadata.event_timestamp.seconds

  match:
    $device_ip over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1602.002")
    $primary_entity = array_distinct($device_ip)
    $inbound_sources = array_distinct($inbound.principal.ip)
    $inbound_ports = array_distinct($inbound.target.port)
    $export_destinations = array_distinct($outbound.target.ip)
    $export_ports = array_distinct($outbound.target.port)
    $inbound_count = count($inbound.metadata.id)
    $outbound_count = count($outbound.metadata.id)

  condition:
    $inbound and $outbound
}
