/*
  MITRE Technique : T1080 - Taint Shared Content
  Tactic(s)       : Lateral Movement
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:21:30.817018+00:00
  Reference       : https://attack.mitre.org/techniques/T1080
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1080_Linux_Shared_Content_Executable_Tainted {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects modification of an existing executable or script file (shell, Python, Perl, PHP, shared object, JAR, .desktop launcher) located on a network or shared-storage mount path such as /mnt, /media, /srv/samba, /srv/nfs, /net or /export. Adding malicious content to files on shared storage is the core mechanism of Taint Shared Content, because the next user or system to run the file executes the attacker's code."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1080"
    mitre_technique_name = "Taint Shared Content"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file watches (write/attribute changes) on mounted shares, normalised to FILE_MODIFICATION with principal.hostname, principal.user.userid, principal.process.file.full_path and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Developers or admins editing scripts stored on NFS/SMB shares, CI/CD or deployment jobs that publish scripts to shared storage, configuration management agents, backup or sync tools restoring files, and software installers writing libraries to shared application mounts."
    tuning_guidance = "Add approved deployment and sync tooling to %global_allowed_admin_tools, backup and imaging software to %global_allowed_backup_processes, automation accounts to %global_allowed_service_accounts, and named administrators to %global_allowed_admin_users. Extend the mount path regex if the client uses non-standard share mount points, and raise severity for shares that are widely used across many hosts."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(mnt|media|net|export|srv\/(samba|nfs|share|shares)|run\/media\/[^\/]+)\/.+\.(sh|bash|py|pl|rb|php|so|jar|desktop|run|bin|elf)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1080")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $actor_users = array_distinct($file.principal.user.userid)
    $actor_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
