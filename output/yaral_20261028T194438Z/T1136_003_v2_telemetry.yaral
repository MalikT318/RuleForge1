/*
  MITRE Technique : T1136.003 - Cloud Account
  Tactic(s)       : Persistence
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Office Suite
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:11:09.641323+00:00
  Reference       : https://attack.mitre.org/techniques/T1136/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1136_003_Cloud_Service_Identity_Created_Or_Credentialed {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a tenant configuration change that creates a non-human cloud identity (application or service principal) or adds credentials or owners to one. These changes give an adversary secondary credentialed access that survives user password resets and does not depend on an interactive user account. The rule works on the resulting audit state change, not on any command line or client tooling."
    mitre_tactic = "Persistence"
    mitre_technique = "T1136.003"
    mitre_technique_name = "Create Account: Cloud Account"
    log_prerequisites = "Requires unified audit logs for directory and application management operations, ingested into UDM with the operation name in metadata.product_event_type. The parser must map these operations to SETTING_MODIFICATION. Verify the mapping per client before deployment, because some parsers map them to other event types."
    platform = "Office Suite"
    log_source = "m365"
    false_positives = "Legitimate application registrations by developers or admins, SaaS onboarding and integration setup, scheduled secret or certificate rotation by automation, IT-managed migration projects, third-party app consent workflows."
    tuning_guidance = "Add approved admin accounts to %global_allowed_admin_users. Add automation and secret-rotation identities to %global_allowed_service_accounts. Add approved identity or app-management principals to %global_allowed_cloud_principals. Consider raising severity if the actor is not a member of an admin role or the source IP is unfamiliar."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.metadata.product_event_type = /^(add service principal|add service principal credentials|add application|add owner to service principal|add owner to application|update application.{1,5}certificates and secrets management)\.?$/ nocase
    $setting.principal.user.userid != ""
    not $setting.principal.user.userid in %global_allowed_admin_users
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1136.003")
    $primary_entity = array_distinct($setting.principal.user.userid)
    $operation = array_distinct($setting.metadata.product_event_type)
    $target_resource = array_distinct($setting.target.resource.name)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
