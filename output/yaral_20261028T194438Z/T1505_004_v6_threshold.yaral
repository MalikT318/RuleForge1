/*
  MITRE Technique : T1505.004 - IIS Components
  Tactic(s)       : Persistence
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:32:34.325399+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/004
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_004_IIS_Component_DLL_Burst_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Several DLL files are written under IIS program or web-root directories on a single host within ten minutes. This volume of module, ISAPI extension or filter drops is uncommon outside planned IIS installs, patching or application deployments, and may indicate installation of a malicious IIS component for persistence."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.004"
    mitre_technique_name = "Server Software Component: IIS Components"
    log_prerequisites = "Requires EDR or Sysmon-style file creation telemetry (FILE_CREATION) with the target file path and the creating (principal) process populated, from IIS servers."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "IIS role or feature installation, Windows Update and servicing, web application deployments (CI/CD, WebDeploy) that publish bin folders, vendor installers for WAF, URL Rewrite or ARR modules, and RMM patching."
    tuning_guidance = "Add deployment and patching tooling to %global_allowed_admin_tools, and deployment or CI service accounts to %global_allowed_service_accounts. Raise the #file threshold on servers with frequent application publishing. Scope the rule to IIS servers if the asset inventory allows."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\\(inetsrv|inetpub)\\.*\.dll$/ nocase
    not $file.target.file.full_path = /\\Temporary ASP\.NET Files\\/ nocase
    not $file.principal.process.file.full_path = /\\(TrustedInstaller|TiWorker|msiexec|wusa)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1505.004")
    $primary_entity = array_distinct($host)
    $file_count = count($file.metadata.id)
    $dropped_paths = array_distinct($file.target.file.full_path)
    $creating_processes = array_distinct($file.principal.process.file.full_path)
    $users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 3
}
