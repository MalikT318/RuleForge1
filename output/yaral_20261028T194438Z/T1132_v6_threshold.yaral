/*
  MITRE Technique : T1132 - Data Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:45:04.684373+00:00
  Reference       : https://attack.mitre.org/techniques/T1132
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_Proxy_Encoded_Payload_URL_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Windows host sends many outbound HTTP requests within ten minutes whose URL query values carry long Base64-style encoded strings. The pattern is consistent with C2 beaconing or tasking that is encoded to blend into web traffic. One such request is common. Repeated requests from one host indicate automated encoded channel traffic."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132"
    mitre_technique_name = "Data Encoding"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url populated and a resolvable source hostname. Must provide URL-level visibility, such as TLS inspection or an explicit proxy."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Web analytics and advertising beacons, OAuth/SSO and SaaS session tokens in query strings, software update and telemetry clients, CDN signed URLs, browser safe-browsing lookups, cloud storage pre-signed links."
    tuning_guidance = "Add known-good vendor and SaaS domains to %global_allowed_domains. Raise the #http threshold on noisy hosts such as proxies, terminal servers or build servers. Lower it only if the URL regex is tightened to a longer minimum string length."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /[?&][^=&]{1,32}=[A-Za-z0-9%+\/_-]{40,}(={0,3}|%3[dD]){0,2}(&|$)/
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    $http.principal.hostname = $host

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1132")
    $primary_entity = array_distinct($host)
    $event_count = count($http.metadata.id)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $sample_urls = array_distinct($http.target.url)

  condition:
    #http >= 15
}
