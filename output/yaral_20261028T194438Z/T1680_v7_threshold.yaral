/*
  MITRE Technique : T1680 - Local Storage Discovery
  Tactic(s)       : Discovery
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:29:14.160398+00:00
  Reference       : https://attack.mitre.org/techniques/T1680
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1680_Linux_Storage_Discovery_Burst {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of local storage and disk enumeration utilities (lsblk, fdisk, parted, blkid, lshw, findmnt, df, smartctl and similar) launched on a single Linux host within ten minutes. Any one invocation is routine; repeated enumeration is consistent with ransomware preparation, lateral movement staging, or a precursor to direct volume access."
    mitre_tactic = "Discovery"
    mitre_technique = "T1680"
    mitre_technique_name = "Local Storage Discovery"
    log_prerequisites = "Requires Linux EDR process telemetry or auditd execve records (SYSCALL/EXECVE) normalised to UDM PROCESS_LAUNCH with target process path and command line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Monitoring and inventory agents polling disk usage (df, lsblk), configuration management runs, backup and imaging software, installers and provisioning scripts, cloud-init, and administrators troubleshooting disk or capacity issues."
    tuning_guidance = "Add inventory, monitoring and patching tooling to %global_allowed_admin_tools, backup software to %global_allowed_backup_processes, and automation accounts to %global_allowed_service_accounts. Raise the #proc threshold for hosts with chatty monitoring agents, or lower it on servers that should never run interactive disk tools."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(lsblk|fdisk|sfdisk|cfdisk|parted|blkid|lshw|findmnt|blockdev|smartctl|hdparm|lsscsi|df|pvs|vgs|lvs|pvdisplay|vgdisplay|lvdisplay)$/ nocase
    $proc.principal.hostname = $host
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_backup_processes
    not $proc.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($proc.target.process.file.full_path = /\/(fdisk|sfdisk|cfdisk|parted|blockdev|hdparm)$/ nocase, 55, 40))
    $event_count = count($proc.metadata.id)
    $mitre_technique_id = array_distinct("T1680")
    $primary_entity = array_distinct($host)
    $tools_seen = array_distinct($proc.target.process.file.full_path)
    $users_seen = array_distinct($proc.principal.user.userid)
    $command_lines = array_distinct($proc.target.process.command_line)

  condition:
    #proc >= 6
}
