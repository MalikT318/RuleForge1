/*
  MITRE Technique : T1053.005 - Scheduled Task
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 1h
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:17:11.330932+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_005_Excessive_Scheduled_Task_Creation_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of scheduled task creation events on a single Windows host within one hour. Creating one task is routine, but several in a short window can indicate persistence staging, lateral-movement tooling, or malware installing recurring execution. This rule uses task-creation telemetry rather than process command lines, so it also covers tasks created through the Task Scheduler API, WMI, or .NET wrappers."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.005"
    mitre_technique_name = "Scheduled Task/Job: Scheduled Task"
    log_prerequisites = "Requires Windows scheduled task creation telemetry normalised to SCHEDULED_TASK_CREATION (Windows Security Event 4698, TaskScheduler Operational Event 106, or equivalent EDR/Sysmon-based task telemetry). Hostname must be populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Software deployment and patching waves, RMM agent enrolment, endpoint management agents, application installers that register several maintenance tasks, OS feature updates, and golden-image or VDI provisioning."
    tuning_guidance = "Add approved deployment, patching and RMM binaries to %global_allowed_admin_tools and automation accounts to %global_allowed_service_accounts. Raise the #task threshold for noisy build, VDI or imaging hosts. Severity scales through $risk_score in the outcome section."

  events:
    $task.metadata.event_type = "SCHEDULED_TASK_CREATION"
    $task.principal.hostname = $host
    not $task.principal.user.userid in %global_allowed_service_accounts
    not $task.principal.process.file.full_path in %global_allowed_admin_tools
    not $task.principal.process.file.full_path = /\\(TiWorker|TrustedInstaller|MsMpEng|musnotification|usoclient)\.exe$/ nocase

  match:
    $host over 1h

  outcome:
    $task_count = count($task.metadata.id)
    $risk_score = max(if($task_count >= 15, 85, if($task_count >= 8, 70, 50)))
    $mitre_technique_id = array_distinct("T1053.005")
    $primary_entity = array_distinct($host)
    $creating_users = array_distinct($task.principal.user.userid)
    $creating_processes = array_distinct($task.principal.process.file.full_path)

  condition:
    #task >= 5
}
