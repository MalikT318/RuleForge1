/*
  MITRE Technique : T1565.001 - Stored Data Manipulation
  Tactic(s)       : Impact
  Rule variant    : 7 of 7  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:40:30.904000+00:00
  Reference       : https://attack.mitre.org/techniques/T1565/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1565_001_Mass_Data_File_Modification_By_Interpreter {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a script interpreter or command shell modifying a large number of document, database or mailbox files on a single host within 10 minutes. Any one modification is benign, but bulk in-place modification of stored data by a scripting engine is consistent with stored data manipulation (for example, tampering with records, spreadsheets or databases to alter business outcomes or hide activity)."
    mitre_tactic = "Impact"
    mitre_technique = "T1565.001"
    mitre_technique_name = "Data Manipulation: Stored Data Manipulation"
    log_prerequisites = "Requires endpoint file telemetry that populates FILE_MODIFICATION events with principal.process.file.full_path and target.file.full_path (EDR or Sysmon file events)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Data migration or ETL scripts, administrator PowerShell or batch jobs that bulk-edit spreadsheets or databases, build and reporting automation, document conversion scripts, and Python or Windows Script Host based business automation."
    tuning_guidance = "Add approved script hosts or parent processes to %global_allowed_script_hosts, approved IT tooling to %global_allowed_admin_tools, and backup or imaging software to %global_allowed_backup_processes. Raise the #file threshold on hosts that run known batch data jobs. Lower it only on high-value data servers."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.principal.process.file.full_path = /\\(powershell|pwsh|cmd|wscript|cscript|mshta|python[0-9.]*|pythonw)\.exe$/ nocase
    $file.target.file.full_path = /\.(docx?|xlsx?|xlsm|pptx?|accdb|mdb|mdf|ldf|sqlite3?|db|sql|pst|ost)$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.process.file.full_path in %global_allowed_security_tools

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1565.001")
    $primary_entity = array_distinct($host)
    $event_count = count($file.metadata.id)
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_processes = array_distinct($file.principal.process.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)

  condition:
    #file >= 50
}
