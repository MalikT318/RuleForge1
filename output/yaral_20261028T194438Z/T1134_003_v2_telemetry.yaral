/*
  MITRE Technique : T1134.003 - Make and Impersonate Token
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 2 of 7  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:57:01.342042+00:00
  Reference       : https://attack.mitre.org/techniques/T1134/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1134_003_NewCredentials_Logon_Token_Creation {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Windows logon session created with the NewCredentials logon type (Security event 4624, logon type 9). This is the authentication artifact left when LogonUser is called with LOGON32_LOGON_NEW_CREDENTIALS and the token is then applied to a thread or process, or when runas /netonly is used. The rule works from the resulting authentication record rather than process command lines, so it still fires if command-line logging is evaded."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1134.003"
    mitre_technique_name = "Access Token Manipulation: Make and Impersonate Token"
    log_prerequisites = "Windows Security event log 4624 (Audit Logon, success) forwarded and normalised to UDM USER_LOGIN. The logon type must map to extensions.auth.mechanism = NEW_CREDENTIALS. Endpoint telemetry that emits logon events is also acceptable."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators using runas /netonly, RMM and deployment agents that use alternate network credentials, backup and management software, developers connecting to remote resources with different credentials, and some scheduled automation using service accounts."
    tuning_guidance = "Add approved service and automation accounts to %global_allowed_service_accounts, named admins to %global_allowed_admin_users, and approved admin tooling binaries to %global_allowed_admin_tools. If volume is high, scope the rule to servers or sensitive hosts, or correlate it with subsequent network logons to remote hosts."

  events:
    $auth.metadata.event_type = "USER_LOGIN"
    $auth.extensions.auth.mechanism = "NEW_CREDENTIALS"
    $auth.target.user.userid != ""
    not $auth.target.user.userid = /\$$/ nocase
    not $auth.target.user.userid = /^(system|local service|network service|anonymous logon|dwm-\d+|umfd-\d+)$/ nocase
    not $auth.target.user.userid in %global_allowed_service_accounts
    not $auth.target.user.userid in %global_allowed_admin_users
    not $auth.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1134.003")
    $primary_entity = array_distinct($auth.principal.hostname)
    $impersonated_user = array_distinct($auth.target.user.userid)
    $logon_process = array_distinct($auth.principal.process.file.full_path)

  condition:
    $auth
}
