/*
  MITRE Technique : T1001 - Data Obfuscation
  Tactic(s)       : Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T23:04:36.210953+00:00
  Reference       : https://attack.mitre.org/techniques/T1001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1001_ESXi_Protocol_Port_Mismatch_Egress {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an ESXi hypervisor host making an outbound connection to an external destination where the perimeter device's protocol identification disagrees with the destination port (HTTP on a non-web port, or DNS on a non-DNS port). This is characteristic of C2 traffic hidden by impersonating a legitimate protocol. ESXi hosts rarely initiate internet-bound sessions at all, so any protocol/port mismatch from one is high-signal."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1001"
    mitre_technique_name = "Data Obfuscation"
    log_prerequisites = "Firewall or proxy perimeter logs normalised to UDM NETWORK_CONNECTION with network.application_protocol populated (application-aware inspection enabled), and ESXi host identity resolved to principal.hostname via DHCP, DNS or asset enrichment."
    platform = "ESXi"
    log_source = "firewall"
    false_positives = "Vendor or backup appliances on non-standard web ports, HTTP-based management or update services (for example an HTTP proxy on a custom port), DNS forwarders on custom ports, firewall application-identification misclassification, and hosts whose names match the ESXi naming pattern but are not hypervisors."
    tuning_guidance = "Add known-good external destinations to %global_allowed_domains and approved management or jump-host source addresses to %global_allowed_mgmt_sources. Adjust the principal.hostname regex to the client's ESXi naming convention. Add approved custom web or DNS ports to the port exclusions. Confirm the firewall populates network.application_protocol before enabling."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname = /(^|[-_.])(esxi?|vmhost)([-_.0-9]|$)/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_mgmt_sources
    (
      (
        $net.network.application_protocol = "HTTP" and
        $net.target.port != 80 and
        $net.target.port != 8000 and
        $net.target.port != 8008 and
        $net.target.port != 8080 and
        $net.target.port != 3128
      ) or
      (
        $net.network.application_protocol = "DNS" and
        $net.target.port != 53 and
        $net.target.port != 5353
      )
    )

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1001")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $observed_protocols = array_distinct($net.network.application_protocol)

  condition:
    $net
}
