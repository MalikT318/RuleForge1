/*
  MITRE Technique : T1564.001 - Hidden Files and Directories
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:14:24.542924+00:00
  Reference       : https://attack.mitre.org/techniques/T1564/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1564_001_Hidden_Directory_Process_External_Network {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process running from a directory commonly hidden or ignored by users (Recycle Bin, System Volume Information, or a dot-prefixed folder at the drive root, under ProgramData, or under Users Public) that makes a network connection to an external address. Binaries staged in hidden directories and beaconing out are a network-side indicator of T1564.001. This is additive to command-line rules for attrib.exe because it keys on network behaviour from the hidden location and does not depend on how the folder was hidden."
    mitre_tactic = "Stealth"
    mitre_technique = "T1564.001"
    mitre_technique_name = "Hide Artifacts: Hidden Files and Directories"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3) that populates principal.process.file.full_path and target.ip on NETWORK_CONNECTION events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup or imaging agents staging binaries in System Volume Information; developer tooling or portable apps installed in dot-prefixed folders under ProgramData or Users Public; software updaters that unpack into hidden temporary folders; RMM agents with hidden install directories."
    tuning_guidance = "Add legitimate agent executable paths to %global_allowed_admin_tools, %global_allowed_backup_processes or %global_allowed_security_tools. Add approved destination domains to %global_allowed_domains if domain enrichment is populated. Raise severity if the process was also seen in a recent PROCESS_LAUNCH from a user-writable path."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /^[a-z]:\\((\$recycle\.bin|recycler|system volume information)|((programdata|users\\public)\\)?\.[^\\]+)\\/ nocase
    $net.principal.hostname != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1564.001")
    $primary_entity = array_distinct($net.principal.hostname)
    $process_path = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
