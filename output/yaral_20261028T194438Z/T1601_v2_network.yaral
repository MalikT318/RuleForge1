/*
  MITRE Technique : T1601 - Modify System Image
  Tactic(s)       : Defense Impairment
  Rule variant    : 2 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:10:44.710463+00:00
  Reference       : https://attack.mitre.org/techniques/T1601
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1601_TFTP_Image_Transfer_External {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects TFTP (UDP/69) sessions crossing the network perimeter, with either the source or the destination outside internal address space. TFTP is the usual protocol for staging or pulling a network device operating-system image. Legitimate TFTP stays inside management VLANs, so an external endpoint suggests a device image being replaced or fetched from attacker infrastructure, or an exposed TFTP service on the device."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1601"
    mitre_technique_name = "Modify System Image"
    log_prerequisites = "Firewall or perimeter connection logs that populate network.ip_protocol, principal.ip, target.ip and target.port, with TFTP (UDP/69) visibility. Management-plane traffic from network devices must traverse the logging firewall."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Vendor-supported remote firmware staging over TFTP, managed service provider provisioning of new devices, lab or staging devices behind NAT, PXE or zero-touch provisioning that uses an external boot server, and misconfigured devices that fetch config or firmware from a public TFTP server."
    tuning_guidance = "Add approved management or provisioning source addresses to %global_allowed_mgmt_sources. Add authorised security testing sources to %global_allowed_scanners. Review %rfc1918_internal so it covers the customer's internal address space. Correlate hits with device management-plane logs showing firmware or boot-variable changes."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "UDP"
    $net.target.port = 69
    (
      not $net.target.ip in %rfc1918_internal or
      not $net.principal.ip in %rfc1918_internal
    )
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.target.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1601")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
