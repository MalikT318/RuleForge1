/*
  MITRE Technique : T1082 - System Information Discovery
  Tactic(s)       : Discovery
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:49:03.532293+00:00
  Reference       : https://attack.mitre.org/techniques/T1082
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1082_ESXi_Discovery_Binary_From_Anomalous_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects ESXi system-information discovery utilities (esxcli, vim-cmd, esxcfg-info, vmware, uname, hostname) spawned by an anomalous parent. Anomalous parents are a script interpreter, or an executable running from a world-writable or datastore location (/tmp, /var/tmp, /dev/shm, /scratch, /vmfs/volumes). Legitimate administration normally comes from an interactive SSH shell or from the hypervisor's own management daemons. This rule keys on process lineage rather than command-line content."
    mitre_tactic = "Discovery"
    mitre_technique = "T1082"
    mitre_technique_name = "System Information Discovery"
    log_prerequisites = "ESXi shell/process execution logging forwarded to Chronicle and normalised to PROCESS_LAUNCH with both parent (principal.process) and child (target.process) executable paths populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Host-profile or configuration-management scripts written in Python or Perl, vendor health-check or monitoring agents running from a datastore or /scratch, patching and upgrade tooling staged in /tmp or /vmfs/volumes, and admin automation (PowerCLI-driven or cron-based) that runs inventory commands."
    tuning_guidance = "Add approved automation parents (full path) to %global_allowed_admin_tools or %global_allowed_script_hosts. Add known automation accounts to %global_allowed_service_accounts. If a customer runs routine Python-based inventory scripts, allowlist the specific parent path rather than removing the interpreter match."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\/(esxcli|vim-cmd|esxcfg-info|vmware|uname|hostname)$/ nocase
    $proc.principal.process.file.full_path = /(^\/(tmp|var\/tmp|dev\/shm|scratch|vmfs\/volumes)\/|\/(python[0-9.]*|perl)$)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1082")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
