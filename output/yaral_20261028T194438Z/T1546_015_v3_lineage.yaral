/*
  MITRE Technique : T1546.015 - Component Object Model Hijacking
  Tactic(s)       : Privilege Escalation, Persistence
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:20:42.421655+00:00
  Reference       : https://attack.mitre.org/techniques/T1546/015
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1546_015_COM_Hijack_From_Unexpected_Parent {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a shell, script interpreter or registry utility that is spawned by an Office application, web server, print spooler or database service and whose command line touches COM registration keys (CLSID, TypeLib, InprocServer32, LocalServer32, TreatAs, ScriptletURL). These parents should not spawn tooling that edits COM registrations, so the lineage points to exploitation or a macro dropping COM-hijack persistence."
    mitre_tactic = "Privilege Escalation, Persistence"
    mitre_technique = "T1546.015"
    mitre_technique_name = "Event Triggered Execution: Component Object Model Hijacking"
    log_prerequisites = "Windows endpoint process telemetry with parent process path and child command line populated (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office add-in installers or VSTO deployment scripts that register COM components; web or database application installers and updaters running registration scripts; print driver or print management software registering COM servers from the spooler; software packaging tools launched from an application service."
    tuning_guidance = "Add approved deployment or registration parent binaries to %global_allowed_admin_tools, and trusted script-launching parents to %global_allowed_script_hosts. Add EDR or AV parents to %global_allowed_security_tools. Add known automation accounts to %global_allowed_service_accounts. To widen coverage, extend the parent regex with additional application server or database service names."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|w3wp|httpd|nginx|php-cgi|tomcat[0-9]*|spoolsv|sqlservr|mysqld|oracle)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(reg|regedit|powershell|pwsh|cmd|wscript|cscript|mshta|regsvr32|rundll32|wmic)\.exe$/ nocase
    $proc.target.process.command_line = /(\\classes\\(wow6432node\\)?(clsid|typelib)|inprocserver32|localserver32|treatas|scriptleturl)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_security_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1546.015")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $acting_user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
