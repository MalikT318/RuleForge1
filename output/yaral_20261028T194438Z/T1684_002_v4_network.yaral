/*
  MITRE Technique : T1684.002 - Email Spoofing
  Tactic(s)       : Stealth
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:33:40.590436+00:00
  Reference       : https://attack.mitre.org/techniques/T1684/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1684_002_Linux_Non_MTA_Outbound_SMTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host where a process that is not a recognised mail transfer agent opens an outbound SMTP connection (25, 465 or 587) to an external address. Scripts, interpreters and ad-hoc tools that talk SMTP directly to external mail servers are a common way to send mail with a forged sender identity (spoofed From or envelope sender) without going through the organisation's authenticated mail gateway."
    mitre_tactic = "Stealth"
    mitre_technique = "T1684.002"
    mitre_technique_name = "Email Spoofing"
    log_prerequisites = "Requires Linux EDR or auditd network telemetry normalised to UDM NETWORK_CONNECTION, with principal.process.file.full_path and target.port populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Monitoring and alerting scripts that send mail directly to an external relay, application servers (CMS, ticketing, backup reports) sending notifications, mail clients on admin workstations, and legitimate MTAs installed in non-standard paths."
    tuning_guidance = "Add approved notification and monitoring tooling to %global_allowed_admin_tools. Add known mail relay and application hosts to %global_allowed_script_hosts. Extend the MTA path regex if a non-standard MTA is deployed. Narrow the port list to 25 only if 465/587 submission traffic to approved cloud relays is noisy."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 25 or
      $net.target.port = 465 or
      $net.target.port = 587
    )
    $net.principal.hostname != ""
    $net.principal.process.file.full_path != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\/postfix\/(sbin\/)?(smtp|master|qmgr)$|\/(sendmail(\.sendmail)?|exim4?)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1684.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $source_user = array_distinct($net.principal.user.userid)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
