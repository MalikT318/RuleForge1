/*
  MITRE Technique : T1613 - Container and Resource Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Container runtime / Kubernetes
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:35:34.660329+00:00
  Reference       : https://attack.mitre.org/techniques/T1613
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1613_External_Container_API_Discovery_HTTP {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects HTTP requests from a non-internal source to container or Kubernetes management API discovery endpoints (list containers, images, pods, nodes, namespaces, services, or kubelet running pods). Such requests indicate enumeration of container resources through an exposed Docker, Kubernetes API server, or kubelet interface."
    mitre_tactic = "Discovery"
    mitre_technique = "T1613"
    mitre_technique_name = "Container and Resource Discovery"
    log_prerequisites = "Requires network or HTTP telemetry that records request URLs for container hosts and Kubernetes nodes or control planes (for example an API gateway, ingress, load balancer, or network sensor with HTTP parsing). Requires TLS inspection or terminated TLS for visibility into URL paths."
    platform = "Containers"
    log_source = "container"
    false_positives = "External monitoring or observability SaaS polling cluster APIs, CI/CD runners outside the internal address space, cloud-managed control-plane health checks, authorised vulnerability scanners and penetration tests, and administrators working remotely through a NAT or VPN egress address."
    tuning_guidance = "Add approved scanner source addresses to %global_allowed_scanners and approved administrative or management source addresses to %global_allowed_mgmt_sources. Add known SaaS monitoring sources to %global_allowed_cloud_principals if they are tracked there. Ensure %rfc1918_internal covers all internal client ranges, including any carrier-grade NAT space used by the cluster."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.target.url = /\/(v[0-9.]+\/)?(containers|images|networks|volumes)\/json|\/api\/v1\/(pods|nodes|namespaces|services|secrets|configmaps)|\/apis\/(apps|batch)\/v1\/(deployments|daemonsets|jobs)|\/(runningpods|pods)(\/|\?|$)/ nocase
    $http.network.http.method = /^(GET|POST)$/ nocase
    not $http.principal.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    not $http.principal.ip in %global_allowed_mgmt_sources

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1613")
    $primary_entity = array_distinct($http.target.hostname)
    $source_ips = array_distinct($http.principal.ip)
    $requested_urls = array_distinct($http.target.url)

  condition:
    $http
}
