/*
  MITRE Technique : T1563.001 - SSH Hijacking
  Tactic(s)       : Lateral Movement
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:09:10.005818+00:00
  Reference       : https://attack.mitre.org/techniques/T1563/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1563_001_Linux_Internal_SSH_From_Non_Mgmt_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects internal-to-internal SSH (TCP/22) connections observed at the network perimeter or internal firewall where the source is not an approved management or scanning source. A hijacked SSH session or agent socket on a compromised Linux host is used to pivot to trusted peers, which appears on the wire as SSH from a workstation or server that does not normally originate SSH. Firewall telemetry cannot see the agent socket or the process, so this is a network-layer approximation that surfaces lateral SSH from unexpected sources for triage."
    mitre_tactic = "Lateral Movement"
    mitre_technique = "T1563.001"
    mitre_technique_name = "Remote Service Session Hijacking: SSH Hijacking"
    log_prerequisites = "Firewall, proxy or network perimeter logs that capture east-west traffic with source IP, destination IP and destination port normalised to UDM NETWORK_CONNECTION. The firewall must sit on internal segment boundaries, otherwise same-segment SSH is not visible. Populate %global_allowed_mgmt_sources with bastions, jump hosts and admin subnets as strings, and %rfc1918_internal with internal address strings."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Bastion and jump hosts not yet in the allowlist, configuration management and orchestration controllers (SSH-based), CI/CD runners deploying over SSH, backup jobs using rsync over SSH, internal vulnerability scanners, and administrators connecting directly from their workstations."
    tuning_guidance = "Add jump hosts, admin subnets and automation controllers to %global_allowed_mgmt_sources. Add authorised scanners to %global_allowed_scanners. Consider severity escalation when the destination is a sensitive server tier, or pair with an auditd or EDR rule on the destination for ssh-agent socket access under /tmp/ssh-*."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.target.port = 22
    $net.principal.ip in %rfc1918_internal
    $net.target.ip in %rfc1918_internal
    $net.principal.ip != $net.target.ip
    not $net.principal.ip in %global_allowed_mgmt_sources
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(40)
    $mitre_technique_id = array_distinct("T1563.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)

  condition:
    $net
}
