/*
  MITRE Technique : T1059.007 - JavaScript
  Tactic(s)       : Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:16:24.513965+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_007_Unexpected_Parent_Spawns_JS_Engine {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Windows JavaScript/JScript execution host (wscript, cscript, mshta, node) launched by a parent process that should never spawn script interpreters, such as an Office application, PDF reader, web server worker, database service, print spooler or WMI provider host. This is a process-lineage detection and does not depend on command-line content."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.007"
    mitre_technique_name = "Command and Scripting Interpreter: JavaScript"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry with populated parent process path (EDR, Sysmon Event ID 1, or Security Event 4688 with parent process name)."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Office macros or add-ins in legitimate line-of-business workflows that call wscript/cscript; web applications or IIS/Tomcat-hosted apps that intentionally run server-side scripts; database jobs running node/cscript maintenance scripts; print or document management software; WMI-based inventory or deployment tooling."
    tuning_guidance = "Add approved parent process paths to %global_allowed_script_hosts and sanctioned management or deployment tooling to %global_allowed_admin_tools. Extend or narrow the parent regex per customer if a specific application legitimately spawns script hosts."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|visio|onenote|acrord32|acrobat|foxitreader|w3wp|httpd|nginx|tomcat\d*|php-cgi|sqlservr|mysqld|spoolsv|wmiprvse)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(wscript|cscript|mshta|node)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1059.007")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
