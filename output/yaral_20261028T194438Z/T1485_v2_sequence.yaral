/*
  MITRE Technique : T1485 - Data Destruction
  Tactic(s)       : Impact
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:35:48.992860+00:00
  Reference       : https://attack.mitre.org/techniques/T1485
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_Mass_User_File_Overwrite_Then_Delete_By_Same_Process {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A single process on one host modifies (overwrites) many user data files and then deletes many user data files within 10 minutes. This overwrite-then-delete pattern is typical of wiper malware destroying data so it cannot be recovered. The detection uses file telemetry and process attribution rather than command-line matching."
    mitre_tactic = "Impact"
    mitre_technique = "T1485"
    mitre_technique_name = "Data Destruction"
    log_prerequisites = "Requires endpoint file telemetry (FILE_MODIFICATION and FILE_DELETION with the acting process populated), such as EDR file events or Sysmon file events."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup, sync and archiving tools (cloud sync clients, backup agents); software that rewrites and cleans up document caches; data-sanitisation or secure-erase utilities run by IT; bulk file migration or cleanup scripts; document management or antivirus quarantine activity."
    tuning_guidance = "Add approved backup and imaging processes to %global_allowed_backup_processes, IT cleanup and deployment tooling to %global_allowed_admin_tools, and security agents to %global_allowed_security_tools. Adjust the #mod and #del thresholds per client based on normal user file churn, and extend the extension list for client-specific data types."

  events:
    $mod.metadata.event_type = "FILE_MODIFICATION"
    $mod.target.file.full_path = /\\users\\[^\\]+\\.*\.(docx?|xlsx?|pptx?|pdf|jpe?g|png|txt|csv|sql|mdb|accdb|bak|zip)$/ nocase
    not $mod.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|onenote|acrobat|acrord32|notepad|onedrive|dropbox|explorer|MsMpEng|MsSense|SenseIR)\.exe$/ nocase
    not $mod.principal.process.file.full_path in %global_allowed_backup_processes
    not $mod.principal.process.file.full_path in %global_allowed_admin_tools
    not $mod.principal.process.file.full_path in %global_allowed_security_tools
    $mod.principal.hostname = $hostname
    $mod.principal.process.file.full_path = $proc_path

    $del.metadata.event_type = "FILE_DELETION"
    $del.target.file.full_path = /\\users\\[^\\]+\\.*\.(docx?|xlsx?|pptx?|pdf|jpe?g|png|txt|csv|sql|mdb|accdb|bak|zip)$/ nocase
    not $del.principal.process.file.full_path in %global_allowed_backup_processes
    not $del.principal.process.file.full_path in %global_allowed_admin_tools
    not $del.principal.process.file.full_path in %global_allowed_security_tools
    $del.principal.hostname = $hostname
    $del.principal.process.file.full_path = $proc_path

    $mod.metadata.event_timestamp.seconds <= $del.metadata.event_timestamp.seconds

  match:
    $hostname, $proc_path over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1485")
    $primary_entity = array_distinct($hostname)
    $acting_process = array_distinct($proc_path)
    $modified_file_count = count($mod.metadata.id)
    $deleted_file_count = count($del.metadata.id)
    $sample_deleted_files = array_distinct($del.target.file.full_path)

  condition:
    #mod >= 10 and #del >= 10
}
