/*
  MITRE Technique : T1566.002 - Spearphishing Link
  Tactic(s)       : Initial Access
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:49:38.806081+00:00
  Reference       : https://attack.mitre.org/techniques/T1566/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1566_002_Linux_Proxy_Repeated_Payload_Downloads_Per_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single Linux host fetches several executable, script or package payloads over HTTP from external destinations within ten minutes, using a browser or command-line downloader user agent. Each request is benign on its own. The volume is consistent with a user following a spearphishing link and being walked through a payload download chain."
    mitre_tactic = "Initial Access"
    mitre_technique = "T1566.002"
    mitre_technique_name = "Phishing: Spearphishing Link"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_HTTP with target.url, target.hostname, network.http.user_agent and principal.hostname populated. SSL inspection is needed to see full URLs for HTTPS traffic."
    platform = "Linux"
    log_source = "firewall"
    false_positives = "Developers and admins pulling install scripts, packages or binaries from external repositories; CI/CD runners; package mirrors not listed in the allowed domains; vulnerability scanners and authorised testing hosts."
    tuning_guidance = "Add known-good package repositories, vendor download sites and CDNs to %global_allowed_domains. Add scanner and authorised test hosts to %global_allowed_scanners. Raise the #http threshold on developer or build-server subnets. Lower it for high-risk user populations."

  events:
    $http.metadata.event_type = "NETWORK_HTTP"
    $http.principal.hostname = $host
    $http.network.http.user_agent = /(x11;.*linux|curl\/|wget\/|python-requests|libwww-perl)/ nocase
    $http.target.url = /\.(sh|elf|run|bin|appimage|deb|rpm|py|pl|jar|zip|tar|gz|tgz)(\?.*)?$/ nocase
    not $http.target.ip in %rfc1918_internal
    not $http.target.hostname in %global_allowed_domains
    not $http.principal.hostname in %global_allowed_scanners

  match:
    $host over 10m

  outcome:
    $risk_score = max(60)
    $event_count = count($http.metadata.id)
    $mitre_technique_id = array_distinct("T1566.002")
    $primary_entity = array_distinct($host)
    $download_urls = array_distinct($http.target.url)
    $destination_hosts = array_distinct($http.target.hostname)
    $user_agents = array_distinct($http.network.http.user_agent)

  condition:
    #http >= 4
}
