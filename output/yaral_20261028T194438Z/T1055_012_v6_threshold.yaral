/*
  MITRE Technique : T1055.012 - Process Hollowing
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Process Injection
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:00:31.604839+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/012
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_012_Repeated_Injection_Into_Common_Hollow_Targets {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects repeated cross-process injection events on a single host within 10 minutes, where the victim is a native Windows binary commonly used as a hollowing host. Any single injection event can be benign; a burst of them from non-allowlisted processes into these targets is consistent with process hollowing and related injection tradecraft. Severity is raised when the victim is a credential or logon process."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.012"
    mitre_technique_name = "Process Injection: Process Hollowing"
    log_prerequisites = "Requires endpoint telemetry that emits cross-process memory write / thread injection events (normalised to PROCESS_INJECTION), with populated principal and target process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Application compatibility shims, accessibility and input software, game overlays, screen-capture or DLP agents, legacy AV/EDR components not in the allowlist, debuggers and developer tooling, and software-packaging or deployment agents."
    tuning_guidance = "Add security agents to %global_allowed_security_tools, deployment or patching tooling to %global_allowed_admin_tools, and imaging or backup agents to %global_allowed_backup_processes. Raise the #inj threshold on hosts with noisy developer or accessibility tooling. Narrow or extend the victim process regex to match the environment."

  events:
    $inj.metadata.event_type = "PROCESS_INJECTION"
    $inj.principal.hostname = $host
    $inj.target.process.file.full_path = /\\(svchost|explorer|rundll32|regsvr32|dllhost|notepad|werfault|msbuild|searchindexer|spoolsv|wuauclt|taskhost|taskhostw|conhost|lsass|winlogon|services)\.exe$/ nocase
    $inj.principal.process.file.full_path != $inj.target.process.file.full_path
    not $inj.principal.process.file.full_path in %global_allowed_security_tools
    not $inj.principal.process.file.full_path in %global_allowed_admin_tools
    not $inj.principal.process.file.full_path in %global_allowed_backup_processes
    not $inj.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR)\.exe$/ nocase

  match:
    $host over 10m

  outcome:
    $risk_score = max(if($inj.target.process.file.full_path = /\\(lsass|winlogon|services)\.exe$/ nocase, 90, 70))
    $event_count = count($inj.metadata.id)
    $mitre_technique_id = array_distinct("T1055.012")
    $primary_entity = array_distinct($host)
    $injecting_processes = array_distinct($inj.principal.process.file.full_path)
    $victim_processes = array_distinct($inj.target.process.file.full_path)
    $affected_users = array_distinct($inj.principal.user.userid)

  condition:
    #inj >= 5
}
