/*
  MITRE Technique : T1053.006 - Systemd Timers
  Tactic(s)       : Execution, Persistence, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Scheduled Tasks / Autostart
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:17:24.604455+00:00
  Reference       : https://attack.mitre.org/techniques/T1053/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1053_006_Systemd_Timer_Unit_File_Created {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation of a systemd .timer unit file in a system-level or user-level unit directory (/etc/systemd/system, /usr/lib/systemd/system, /usr/local/lib/systemd/system, /run/systemd/system, ~/.config/systemd/user). Detects the resulting persistence artifact rather than the command line, so it still fires if the timer is written by a script, an editor, an API or a renamed binary. Package-manager writes, approved admin tooling and approved service accounts are excluded."
    mitre_tactic = "Execution, Persistence, Privilege Escalation"
    mitre_technique = "T1053.006"
    mitre_technique_name = "Scheduled Task/Job: Systemd Timers"
    log_prerequisites = "Requires Linux file-creation telemetry from EDR or auditd (file watch rules on /etc/systemd, /usr/lib/systemd, /run/systemd and user .config/systemd directories) with the writing process and user populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Package installs and upgrades that ship .timer units, configuration management (Ansible, Puppet, Chef, Salt), image-build or golden-image provisioning, administrators creating legitimate maintenance timers, container or cloud-init first-boot setup."
    tuning_guidance = "Add configuration-management and deployment binaries to %global_allowed_admin_tools. Add automation accounts to %global_allowed_service_accounts. Add named administrators to %global_allowed_admin_users. Extend the package-manager regex if the fleet uses other installers. Consider raising severity for creation by non-root users or from interpreters and shells."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    (
      $file.target.file.full_path = /^\/(etc|usr\/lib|lib|usr\/local\/lib|run)\/systemd\/(system|user)\/.+\.timer$/ nocase or
      $file.target.file.full_path = /^\/(home\/[^\/]+|root)\/\.config\/systemd\/user\/.+\.timer$/ nocase
    )
    not $file.principal.process.file.full_path = /\/(dpkg|apt|apt-get|rpm|yum|dnf|zypper|pacman|snapd|packagekitd|unattended-upgrade)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1053.006")
    $primary_entity = array_distinct($file.principal.hostname)
    $timer_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
