/*
  MITRE Technique : T1548.001 - Setuid and Setgid
  Tactic(s)       : Privilege Escalation
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T14:29:37.575919+00:00
  Reference       : https://attack.mitre.org/techniques/T1548/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1548_001_Linux_Setuid_Setgid_Bit_Set_On_Staged_File {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file-attribute modification (chmod/fchmodat via auditd or EDR file telemetry) that sets the setuid or setgid bit on a file in a user-writable or staging location such as /tmp, /var/tmp, /dev/shm, /home, /run/user or a web root. Adversaries do this to plant a persistent privilege-escalation backdoor. This rule is built on FILE_MODIFICATION telemetry, not PROCESS_LAUNCH, and complements process-creation rules."
    mitre_tactic = "Privilege Escalation"
    mitre_technique = "T1548.001"
    mitre_technique_name = "Abuse Elevation Control Mechanism: Setuid and Setgid"
    log_prerequisites = "Linux endpoint telemetry (EDR file-attribute events or auditd chmod/fchmodat/fchmodat2 syscall records) normalised to UDM FILE_MODIFICATION with target.file.full_path and principal.process.command_line populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Software build and packaging jobs that create setuid helpers in temp or home directories, developer workstations compiling and testing setuid binaries, CI runners, configuration management or deployment agents staging files before moving them to system paths, and administrators performing authorised maintenance."
    tuning_guidance = "Add approved configuration-management, build and deployment binaries to %global_allowed_admin_tools. Add CI and automation accounts to %global_allowed_service_accounts. Add approved administrator accounts to %global_allowed_admin_users. Hosts that legitimately compile setuid software can be tuned out by narrowing the staging path regex."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|home|run\/user|var\/www|opt)\// nocase
    $file.principal.process.command_line = /\b(chmod|install)\b/ nocase
    (
      $file.principal.process.command_line = /\s[2467][0-7]{3}(\s|$)/ nocase or
      $file.principal.process.command_line = /(\s|,)[ugoa]*[+=][rwxXt]*s/ nocase
    )
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    not $file.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1548.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $modified_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)
    $acting_processes = array_distinct($file.principal.process.file.full_path)
    $command_lines = array_distinct($file.principal.process.command_line)

  condition:
    $file
}
