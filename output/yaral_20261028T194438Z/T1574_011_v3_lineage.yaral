/*
  MITRE Technique : T1574.011 - Services Registry Permissions Weakness
  Tactic(s)       : Stealth, Execution
  Rule variant    : 3 of 6  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T17:41:54.787105+00:00
  Reference       : https://attack.mitre.org/techniques/T1574/011
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1574_011_Unexpected_Process_Modifies_Service_Registry {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a process that should never configure services (Office application, web server, database service, print spooler, script interpreter or script host, or any executable running from a user-writable location) modifying the ImagePath, ServiceDll or FailureCommand of a service registry key. This is a lineage-anomaly detection on the registry write itself, not on process command lines, and catches service binary hijacking through weak registry permissions after exploitation of an unexpected host process."
    mitre_tactic = "Stealth, Execution"
    mitre_technique = "T1574.011"
    mitre_technique_name = "Hijack Execution Flow: Services Registry Permissions Weakness"
    log_prerequisites = "Requires Windows endpoint registry telemetry (EDR or Sysmon registry value set events) that populates principal.process.file.full_path and target.registry.registry_key."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Administrators changing service configuration interactively through PowerShell or cmd, software installers and updaters launched from temp or ProgramData directories, database or web application installers that register their own services, RMM and deployment agents not yet in the allowlists, and DevOps scripts that provision services."
    tuning_guidance = "Add approved deployment and RMM binaries to %global_allowed_admin_tools, approved script-running parent processes to %global_allowed_script_hosts, security agents to %global_allowed_security_tools, and automation accounts to %global_allowed_service_accounts. If interpreter noise is high, remove cmd and powershell from the suspect-process regex and keep the Office, web, database and spooler parents."

  events:
    $reg.metadata.event_type = "REGISTRY_MODIFICATION"
    $reg.target.registry.registry_key = /\\(CurrentControlSet|ControlSet[0-9]{3})\\Services\\[^\\]+/ nocase
    (
      $reg.target.registry.registry_value_name = /^(ImagePath|ServiceDll|FailureCommand)$/ nocase or
      $reg.target.registry.registry_key = /\\(ImagePath|ServiceDll|FailureCommand)$/ nocase
    )
    (
      $reg.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|w3wp|httpd|nginx|tomcat[0-9]*|java|sqlservr|mysqld|spoolsv|powershell|pwsh|cmd|wscript|cscript|mshta|rundll32|regsvr32)\.exe$/ nocase or
      $reg.principal.process.file.full_path = /\\(Users\\[^\\]+\\|ProgramData\\|Windows\\Temp\\|AppData\\|Temp\\)/ nocase
    )
    $reg.principal.hostname != ""
    not $reg.principal.process.file.full_path in %global_allowed_admin_tools
    not $reg.principal.process.file.full_path in %global_allowed_script_hosts
    not $reg.principal.process.file.full_path in %global_allowed_security_tools
    not $reg.principal.user.userid in %global_allowed_service_accounts
    not $reg.principal.process.file.full_path = /\\(MsMpEng|MsSense|SenseIR|TrustedInstaller|msiexec|services)\.exe$/ nocase

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1574.011")
    $primary_entity = array_distinct($reg.principal.hostname)
    $modifying_process = array_distinct($reg.principal.process.file.full_path)
    $modified_key = array_distinct($reg.target.registry.registry_key)
    $modified_value = array_distinct($reg.target.registry.registry_value_name)
    $acting_user = array_distinct($reg.principal.user.userid)

  condition:
    $reg
}
