/*
  MITRE Technique : T1600 - Weaken Encryption
  Tactic(s)       : Defense Impairment
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:05:25.376683+00:00
  Reference       : https://attack.mitre.org/techniques/T1600
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1600_Mgmt_Plane_Encryption_Downgrade_Sequence {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a possible encryption downgrade against a network device's management plane. One source connects to an internal device on an encrypted management port (SSH, NETCONF over SSH, HTTPS), then to the same device on a cleartext management protocol (Telnet, FTP, TFTP) within 10 minutes. This can indicate that the device's encryption capability has been weakened or disabled, or that an adversary is falling back to unencrypted channels to bypass protections."
    mitre_tactic = "Defense Impairment"
    mitre_technique = "T1600"
    mitre_technique_name = "Weaken Encryption"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip and target.port populated. The firewall must see traffic to the management interfaces of internal network devices."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "Legacy devices that only support Telnet, FTP or TFTP; administrators using SSH for management and TFTP for config or firmware transfer; network automation and backup jobs; vulnerability scanners and asset-discovery tools probing several management ports; jump hosts or bastions that handle both protocol types."
    tuning_guidance = "Add approved admin jump hosts and automation sources to %global_allowed_mgmt_sources. Add authorised scanner sources to %global_allowed_scanners. If TFTP or FTP is routinely used for approved config backups, add the backup server to %global_allowed_mgmt_sources. Raise the risk score for devices that normally never see cleartext management traffic."

  events:
    // Event 1: encrypted management-plane connection to an internal device
    $secure.metadata.event_type = "NETWORK_CONNECTION"
    ($secure.target.port = 22 or $secure.target.port = 830 or $secure.target.port = 443)
    $secure.target.ip in %rfc1918_internal
    not $secure.principal.ip in %global_allowed_mgmt_sources
    not $secure.principal.ip in %global_allowed_scanners
    $secure.principal.ip = $src
    $secure.target.ip = $dst

    // Event 2: cleartext management-plane connection to the same device from the same source
    $clear.metadata.event_type = "NETWORK_CONNECTION"
    ($clear.target.port = 23 or $clear.target.port = 21 or $clear.target.port = 69)
    $clear.target.ip in %rfc1918_internal
    not $clear.principal.ip in %global_allowed_mgmt_sources
    not $clear.principal.ip in %global_allowed_scanners
    $clear.principal.ip = $src
    $clear.target.ip = $dst

    // Chronological order: encrypted first, then cleartext fallback
    $secure.metadata.event_timestamp.seconds <= $clear.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1600")
    $primary_entity = array_distinct($dst)
    $source_ips = array_distinct($src)
    $encrypted_ports = array_distinct($secure.target.port)
    $cleartext_ports = array_distinct($clear.target.port)
    $encrypted_event_count = count($secure.metadata.id)
    $cleartext_event_count = count($clear.metadata.id)

  condition:
    $secure and $clear
}
