/*
  MITRE Technique : T1137.006 - Add-ins
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Parent-child lineage anomaly)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:22:48.677755+00:00
  Reference       : https://attack.mitre.org/techniques/T1137/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1137_006_Office_Addin_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a Microsoft Office application spawning a shell, script interpreter or proxy-execution LOLBin. Malicious Office add-ins (XLL/WLL, VBA, COM, VSTO) run code inside the host Office process at startup. When that code launches a child process, the visible result is an Office parent with an interpreter child. The rule pivots on this lineage anomaly rather than on add-in file names or registry paths."
    mitre_tactic = "Persistence"
    mitre_technique = "T1137.006"
    mitre_technique_name = "Office Application Startup: Add-ins"
    log_prerequisites = "Requires Windows endpoint process-creation telemetry (EDR, Sysmon Event ID 1 or Security Event 4688 with command-line auditing) that populates parent and child process paths."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate VSTO or COM add-ins that shell out (ERP, CRM, document management and PDF tools), finance macros that call cmd or PowerShell, Outlook plug-ins that launch helper scripts, and IT-approved Office automation. Malicious macros or phishing documents spawning shells also match; the lineage is the same, so treat these as relevant leads."
    tuning_guidance = "Add approved parent paths to %global_allowed_script_hosts and approved tooling to %global_allowed_admin_tools. Add known automation accounts to %global_allowed_service_accounts. If a specific line-of-business add-in is noisy, exclude it by child command-line pattern rather than by install path. Correlate with REGISTRY_MODIFICATION under Office Addins or Options\\OPEN keys for confirmation."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|visio|mspub|onenote|msaccess|winproj)\.exe$/ nocase
    $proc.target.process.file.full_path = /\\(cmd|powershell|powershell_ise|pwsh|wscript|cscript|mshta|rundll32|regsvr32|wmic|certutil|bitsadmin|msbuild|installutil)\.exe$/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1137.006")
    $primary_entity = array_distinct($proc.principal.hostname)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $child_process = array_distinct($proc.target.process.file.full_path)
    $child_command_line = array_distinct($proc.target.process.command_line)
    $user = array_distinct($proc.principal.user.userid)

  condition:
    $proc
}
