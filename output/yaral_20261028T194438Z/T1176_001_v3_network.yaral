/*
  MITRE Technique : T1176.001 - Browser Extensions
  Tactic(s)       : Persistence
  Rule variant    : 3 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T03:27:03.091760+00:00
  Reference       : https://attack.mitre.org/techniques/T1176/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1176_001_Browser_Extension_Package_Fetch_From_Unapproved_Host {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects HTTP requests that match the Chromium extension package or update-check protocol (a .crx package download, or an update query carrying a 32-character extension ID) sent to a host outside the approved external domains. Extensions installed from self-hosted or adversary-controlled update URLs, or sideloaded from arbitrary web servers, produce this traffic. Matching on the protocol shape rather than a named domain means the rule still fires if the attacker changes hosting."
    mitre_tactic = "Persistence"
    mitre_technique = "T1176.001"
    mitre_technique_name = "Browser Extensions"
    log_prerequisites = "Requires proxy or firewall logs with full HTTP URL visibility (TLS inspection or explicit proxy) normalised to UDM NETWORK_HTTP with target.url and target.hostname populated."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Enterprise-hosted private extension update servers, vendor-distributed line-of-business browser extensions, developers testing unpacked or self-hosted extensions, and third-party browser extension stores used by the business."
    tuning_guidance = "Add the approved external extension and update hosts (enterprise update server, vendor CDNs) to %global_allowed_domains. Add known scanner sources to %global_allowed_scanners if they trigger the rule. Raise severity for hosts that are not developer workstations."

  events:
    $net.metadata.event_type = "NETWORK_HTTP"
    $net.target.url = /(\.crx(\?|#|$)|[?&]x=id%3D[a-p]{32}(%26|&))/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.target.hostname in %global_allowed_domains
    not $net.principal.ip in %global_allowed_scanners

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1176.001")
    $primary_entity = array_distinct($net.principal.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $requested_urls = array_distinct($net.target.url)

  condition:
    $net
}
