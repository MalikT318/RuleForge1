/*
  MITRE Technique : T1505.001 - SQL Stored Procedures
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:26:01.752863+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_001_Linux_DB_Server_Drops_Library_Then_Spawns_Shell {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A SQL database server process (MySQL/MariaDB, PostgreSQL, SQL Server on Linux) writes a shared library or script into a plugin, library or world-writable staging directory, and the same host then sees that database server process launch a shell or script interpreter within 10 minutes. This is the Linux equivalent of a malicious stored-procedure or UDF persistence chain (library drop, then OS command execution from SQL). It relies on file-write and process-lineage behaviour rather than command-line content."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.001"
    mitre_technique_name = "Server Software Component: SQL Stored Procedures"
    log_prerequisites = "Requires Linux EDR or auditd telemetry providing FILE_CREATION events with the writing process path, and PROCESS_LAUNCH events with parent and child process paths."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Database package upgrades or plugin installs run by the DB service, DBA-approved UDF or extension deployment, PostgreSQL extensions or COPY ... PROGRAM jobs used for legitimate ETL, backup or maintenance scripts launched by the database service, and monitoring agents invoked by the database."
    tuning_guidance = "Add approved DBA, patching and deployment tooling to %global_allowed_admin_tools, and known maintenance or ETL hosts to %global_allowed_script_hosts. Add backup tooling that writes under DB directories to %global_allowed_backup_processes. If DB service names differ per client (for example custom builds), extend the database process regex."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.principal.process.file.full_path = /\/(mysqld|mariadbd|postgres|postmaster|sqlservr)$/ nocase
    $file.target.file.full_path = /\.(so|sh|py|pl|elf)$/ nocase
    $file.target.file.full_path = /^\/(tmp|var\/tmp|dev\/shm)\/|\/plugin\/|\/lib\/postgresql\// nocase
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.hostname in %global_allowed_script_hosts
    $file.principal.hostname = $hostname

    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.principal.process.file.full_path = /\/(mysqld|mariadbd|postgres|postmaster|sqlservr)$/ nocase
    $proc.target.process.file.full_path = /\/(sh|bash|dash|zsh|ash|python[0-9.]*|perl)$/ nocase
    not $proc.target.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.hostname in %global_allowed_script_hosts
    $proc.principal.hostname = $hostname

    $file.metadata.event_timestamp.seconds <= $proc.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1505.001")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_files = array_distinct($file.target.file.full_path)
    $db_processes = array_distinct($file.principal.process.file.full_path)
    $spawned_children = array_distinct($proc.target.process.file.full_path)
    $file_event_count = count($file.metadata.id)

  condition:
    $file and $proc
}
