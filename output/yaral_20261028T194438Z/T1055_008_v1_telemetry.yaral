/*
  MITRE Technique : T1055.008 - Ptrace System Calls
  Tactic(s)       : Stealth, Privilege Escalation
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Process Injection
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T19:54:05.981045+00:00
  Reference       : https://attack.mitre.org/techniques/T1055/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1055_008_Proc_Mem_Write_Ptrace_Scope {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a file-write artifact of ptrace-style process injection on Linux: a write to another process's memory pseudo-file (/proc/<pid>/mem or /proc/<pid>/task/<tid>/mem), which gives the same effect as PTRACE_POKETEXT/POKEDATA. Also detects modification of the Yama ptrace_scope control (/proc/sys/kernel/yama/ptrace_scope), which is commonly loosened so non-child processes can be attached to. This works at the file-state layer and does not depend on command-line logging."
    mitre_tactic = "Stealth, Privilege Escalation"
    mitre_technique = "T1055.008"
    mitre_technique_name = "Process Injection: Ptrace System Calls"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-watch rules (-w /proc/sys/kernel/yama/ptrace_scope -p w, plus write-syscall auditing on /proc/*/mem) normalised to UDM FILE_MODIFICATION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Interactive debuggers (gdb, lldb, gdbserver), live-patching and instrumentation agents, JIT runtimes and crash-dump tooling, and administrators or configuration management deliberately setting ptrace_scope for troubleshooting. Security agents that inspect process memory may also trigger it."
    tuning_guidance = "Add approved debugger, instrumentation and configuration-management binaries to %global_allowed_admin_tools. Add EDR/AV agent binaries to %global_allowed_security_tools. Add backup and imaging agents that touch /proc to %global_allowed_backup_processes. Exclusions are by process path, so use full paths as they appear in the telemetry. On developer workstations, expect more noise and consider a lower severity or a host-group exception."

  events:
    $file.metadata.event_type = "FILE_MODIFICATION"
    $file.target.file.full_path = /^\/proc\/[0-9]+\/(task\/[0-9]+\/)?mem$|^\/proc\/sys\/kernel\/yama\/ptrace_scope$/ nocase
    $file.principal.hostname != ""
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_security_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1055.008")
    $primary_entity = array_distinct($file.principal.hostname)
    $target_path = array_distinct($file.target.file.full_path)
    $writer_process = array_distinct($file.principal.process.file.full_path)
    $writer_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
