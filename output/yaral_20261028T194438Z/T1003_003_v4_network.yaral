/*
  MITRE Technique : T1003.003 - NTDS
  Tactic(s)       : Credential Access
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Credential Dumping / Password Stores
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:41:34.698812+00:00
  Reference       : https://attack.mitre.org/techniques/T1003/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1003_003_NTDS_Tooling_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a built-in Windows AD database / shadow-copy utility (ntdsutil, vssadmin, diskshadow, esentutl, wbadmin) opening a network connection to a non-internal address. These utilities are used to copy or stage NTDS.dit and the SYSTEM hive, and they do not normally make outbound connections to external hosts. An external connection indicates exfiltration or remote staging of Active Directory database material, or abuse of the binary as a proxy or downloader."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1003.003"
    mitre_technique_name = "OS Credential Dumping: NTDS"
    log_prerequisites = "Requires Windows endpoint network telemetry that records the initiating process path (EDR network events or Sysmon Event ID 3) normalised to UDM NETWORK_CONNECTION with principal.process.file.full_path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Backup agents that wrap wbadmin, vssadmin or diskshadow and send data to cloud storage. Disaster-recovery tooling that replicates system state off-site. Administrators running these utilities with remote or cloud-hosted targets. Misattributed process paths from EDR agents that report the parent as the network owner."
    tuning_guidance = "Add approved backup software to %global_allowed_backup_processes and approved admin tooling to %global_allowed_admin_tools. Confirm that %rfc1918_internal covers every private range the client uses; client-specific VPN or CGNAT ranges may need to be added to that list. If a client runs off-site backups through these binaries, scope the exclusion to the specific backup host rather than disabling the rule."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\(ntdsutil|vssadmin|diskshadow|esentutl|wbadmin)\.exe$/ nocase
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_backup_processes
    not $net.principal.process.file.full_path in %global_allowed_admin_tools

  outcome:
    $risk_score = max(85)
    $mitre_technique_id = array_distinct("T1003.003")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)
    $initiating_process = array_distinct($net.principal.process.file.full_path)
    $initiating_user = array_distinct($net.principal.user.userid)

  condition:
    $net
}
