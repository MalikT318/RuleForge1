/*
  MITRE Technique : T1218.007 - Msiexec
  Tactic(s)       : Stealth
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:50:15.205043+00:00
  Reference       : https://attack.mitre.org/techniques/T1218/007
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1218_007_Msiexec_External_Network_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects msiexec.exe (the Windows Installer binary) making an outbound network connection to an external address. This is the network-side footprint of msiexec fetching a remote MSI or DLL payload (for example msiexec /i http://... or a UNC/WebDAV path). It is independent of command-line content, so it still fires when the command line is obfuscated, split or hidden by environment variables."
    mitre_tactic = "Stealth"
    mitre_technique = "T1218.007"
    mitre_technique_name = "System Binary Proxy Execution: Msiexec"
    log_prerequisites = "Requires endpoint network telemetry (EDR or Sysmon Event ID 3 equivalent) that records the initiating process path for outbound connections, normalised to UDM NETWORK_CONNECTION."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate software installs or updates that download MSI packages from vendor CDNs. Software deployment and RMM agents that launch msiexec against external repositories. Windows Installer certificate or CRL revocation checks to Microsoft or CA infrastructure. Users installing approved applications from vendor websites."
    tuning_guidance = "Add approved deployment and patching tooling (parent process paths) to %global_allowed_admin_tools. Add vendor and update domains to %global_allowed_domains. Add automation accounts that legitimately run installs to %global_allowed_service_accounts. Ensure %rfc1918_internal is populated for each client's internal address space."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.process.file.full_path = /\\msiexec\.exe$/ nocase
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.parent_process.file.full_path in %global_allowed_admin_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.target.hostname in %global_allowed_domains

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1218.007")
    $primary_entity = array_distinct($net.principal.hostname)
    $destination_ips = array_distinct($net.target.ip)
    $destination_hosts = array_distinct($net.target.hostname)
    $destination_ports = array_distinct($net.target.port)
    $acting_user = array_distinct($net.principal.user.userid)
    $msiexec_command_line = array_distinct($net.principal.process.command_line)

  condition:
    $net
}
