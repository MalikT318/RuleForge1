/*
  MITRE Technique : T1205.002 - Socket Filters
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 4 of 7  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:13:07.062797+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_002_Linux_Socket_Filter_Backdoor_Outbound_Callback {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Network-side view of a socket-filter (libpcap / SO_ATTACH_FILTER) passive backdoor being triggered. After a crafted packet matches the installed filter, the implant typically calls back or spawns a reverse shell. This rule detects an outbound connection to a non-internal address from a shell interpreter or from a binary running out of a volatile, world-writable location (/tmp, /var/tmp, /dev/shm, /run). Ordinary services do not behave this way."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.002"
    mitre_technique_name = "Traffic Signaling: Socket Filters"
    log_prerequisites = "Linux endpoint telemetry (EDR or auditd with connect() syscall auditing) that populates NETWORK_CONNECTION with the originating process path (principal.process.file.full_path), principal.hostname and target.ip. The %rfc1918_internal reference list must be populated for the tenant."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Admin or deployment scripts that use bash /dev/tcp or curl-style helpers launched from a shell; installers or self-updaters staged in /tmp that fetch packages from external repositories; containerised build agents running from /tmp; monitoring or health-check scripts that connect to external SaaS endpoints."
    tuning_guidance = "Add approved tooling paths to %global_allowed_admin_tools. Add build or automation hosts to %global_allowed_script_hosts. Keep %rfc1918_internal complete for the tenant, including loopback and link-local ranges, to avoid noise. If shell-originated traffic is too noisy, narrow the regex to the volatile-path branch only, or raise the severity only when the destination port is uncommon."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.principal.process.file.full_path = /^\/(tmp|var\/tmp|dev\/shm|run\/shm|run\/user\/[0-9]+|var\/run)\// nocase or
      $net.principal.process.file.full_path = /\/(bash|sh|dash|zsh|ksh|ash|csh|tcsh)$/ nocase
    )
    $net.target.ip != ""
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1205.002")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $process_command_line = array_distinct($net.principal.process.command_line)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
