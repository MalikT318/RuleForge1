/*
  MITRE Technique : T1677 - Poisoned Pipeline Execution
  Tactic(s)       : Execution
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:22:05.121113+00:00
  Reference       : https://attack.mitre.org/techniques/T1677
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1677_CI_Pipeline_Config_Modified_By_Unapproved_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a content update to a CI/CD pipeline definition (workflow, build spec, or pipeline YAML, Jenkinsfile) by an identity that is not an approved service account or administrator. Direct pipeline execution poisoning depends on editing these files so that attacker-controlled steps run with the pipeline's secrets and credentials."
    mitre_tactic = "Execution"
    mitre_technique = "T1677"
    mitre_technique_name = "Poisoned Pipeline Execution"
    log_prerequisites = "SaaS or cloud audit logs that record repository or build-project content updates and populate target.resource.name or target.file.full_path with the changed file path. Typically source-control and CI/CD audit streams ingested into Chronicle."
    platform = "SaaS"
    log_source = "cloud_audit"
    false_positives = "Developers legitimately maintaining pipelines, DevOps or platform engineering changes, dependency-update bots, template or scaffolding tooling, and infrastructure-as-code automation that regenerates pipeline files."
    tuning_guidance = "Add bots and CI automation identities to %global_allowed_service_accounts, and platform or DevOps engineers to %global_allowed_admin_users. Pair with branch-protection and required-review controls, and raise severity when the change comes from an unusual source, a first-time contributor, or outside business hours."

  events:
    $cicd.metadata.event_type = "USER_RESOURCE_UPDATE_CONTENT"
    (
      $cicd.target.resource.name = /(^|\/)(\.gitlab-ci\.ya?ml|jenkinsfile|azure-pipelines\.ya?ml|buildspec\.ya?ml|cloudbuild\.ya?ml|bitbucket-pipelines\.ya?ml|\.circleci\/config\.ya?ml|\.github\/workflows\/[^\/]+\.ya?ml|\.drone\.ya?ml|\.travis\.ya?ml)$/ nocase or
      $cicd.target.file.full_path = /(^|\/)(\.gitlab-ci\.ya?ml|jenkinsfile|azure-pipelines\.ya?ml|buildspec\.ya?ml|cloudbuild\.ya?ml|bitbucket-pipelines\.ya?ml|\.circleci\/config\.ya?ml|\.github\/workflows\/[^\/]+\.ya?ml|\.drone\.ya?ml|\.travis\.ya?ml)$/ nocase
    )
    $cicd.principal.user.userid != ""
    not $cicd.principal.user.userid in %global_allowed_service_accounts
    not $cicd.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1677")
    $primary_entity = array_distinct($cicd.principal.user.userid)
    $modified_resource = array_distinct($cicd.target.resource.name)
    $modified_file = array_distinct($cicd.target.file.full_path)
    $source_ips = array_distinct($cicd.principal.ip)

  condition:
    $cicd
}
