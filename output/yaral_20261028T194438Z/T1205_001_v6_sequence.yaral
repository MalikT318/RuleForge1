/*
  MITRE Technique : T1205.001 - Port Knocking
  Tactic(s)       : Stealth, Persistence, Command and Control
  Rule variant    : 6 of 7  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T04:11:45.687109+00:00
  Reference       : https://attack.mitre.org/techniques/T1205/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1205_001_Port_Knock_Sequence_Then_Allowed_Connection {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "An external source makes several blocked connection attempts to a Windows-hosting destination, then makes an allowed connection to that same destination on a different port within ten minutes. This is the network-observable pattern of a port knock followed by use of the newly opened service."
    mitre_tactic = "Stealth, Persistence, Command and Control"
    mitre_technique = "T1205.001"
    mitre_technique_name = "Traffic Signaling: Port Knocking"
    log_prerequisites = "Perimeter firewall or network flow logs normalised to UDM NETWORK_CONNECTION, with principal.ip, target.ip, target.port and security_result.action populated for both denied and permitted traffic. Deny events must be logged, not suppressed."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Internet-wide scanners and research crawlers that probe closed ports and then reach an open service. Misconfigured clients retrying after a policy change. Authorised penetration tests and vulnerability scans not yet in the scanner list. Legitimate port-knocking or single-packet-authorisation gateways used for administrative access."
    tuning_guidance = "Add authorised scanner and testing sources to %global_allowed_scanners. Add approved management source addresses to %global_allowed_mgmt_sources. Raise the #knock threshold in the condition for noisy internet-facing segments. Narrow the connection side to management ports such as RDP, WinRM or SSH where the client does not expose services intentionally."

  events:
    $knock.metadata.event_type = "NETWORK_CONNECTION"
    $knock.security_result.action = "BLOCK"
    not $knock.principal.ip in %rfc1918_internal
    not $knock.principal.ip in %global_allowed_scanners
    not $knock.principal.ip in %global_allowed_mgmt_sources
    $knock.principal.ip = $src
    $knock.target.ip = $dst

    $conn.metadata.event_type = "NETWORK_CONNECTION"
    $conn.security_result.action = "ALLOW"
    not $conn.principal.ip in %rfc1918_internal
    not $conn.principal.ip in %global_allowed_scanners
    not $conn.principal.ip in %global_allowed_mgmt_sources
    $conn.target.port != 80
    $conn.target.port != 443
    $conn.target.port != 53
    $conn.principal.ip = $src
    $conn.target.ip = $dst

    $knock.target.port != $conn.target.port
    $knock.metadata.event_timestamp.seconds <= $conn.metadata.event_timestamp.seconds

  match:
    $src, $dst over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1205.001")
    $primary_entity = array_distinct($dst)
    $source_ips = array_distinct($src)
    $knock_count = count($knock.metadata.id)
    $knocked_port_count = count_distinct($knock.target.port)
    $knocked_ports = array_distinct($knock.target.port)
    $opened_ports = array_distinct($conn.target.port)

  condition:
    #knock >= 3 and $conn
}
