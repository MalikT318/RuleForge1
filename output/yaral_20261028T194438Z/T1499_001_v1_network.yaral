/*
  MITRE Technique : T1499.001 - OS Exhaustion Flood
  Tactic(s)       : Impact
  Rule variant    : 1 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:16:13.998902+00:00
  Reference       : https://attack.mitre.org/techniques/T1499/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1499_001_Inbound_TCP_Connection_Flood_Single_Source {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "High"
    description = "Detects a TCP connection flood seen at the network perimeter: one external source opens a very high number of connections to the same destination IP and port within one minute. This is the network-side signature of SYN and connection-state exhaustion attacks against a Windows host's TCP stack. A flood cannot be seen in a single log line, so the rule uses a one-minute threshold window and does not depend on endpoint process telemetry."
    mitre_tactic = "Impact"
    mitre_technique = "T1499.001"
    mitre_technique_name = "Endpoint Denial of Service: OS Exhaustion Flood"
    log_prerequisites = "Requires firewall or perimeter logs normalised to NETWORK_CONNECTION with principal.ip, target.ip, target.port and network.ip_protocol populated. Logs must record denied and half-open or failed attempts as well as established sessions, otherwise SYN floods will be under-counted."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Authorised vulnerability scanners and load testers, uptime and synthetic monitors, NAT or proxy gateways aggregating many users behind one public IP, CDN or reverse-proxy egress nodes, misconfigured clients retrying aggressively, and internet background scanning of exposed services."
    tuning_guidance = "Add approved scanner and test sources to %global_allowed_scanners. Raise or lower the '#net' threshold to match the baseline of each client's exposed services. For NAT or proxy gateways that legitimately aggregate users, add their source addresses to %global_allowed_scanners or scope the rule per client. If perimeter logs only record established sessions, lower the threshold. This rule groups by a single source, so a distributed flood needs a companion rule grouped by destination."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.network.ip_protocol = "TCP"
    $net.principal.ip = $src_ip
    $net.target.ip = $dst_ip
    $net.target.port = $dst_port
    not $net.principal.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners

  match:
    $src_ip, $dst_ip, $dst_port over 1m

  outcome:
    $risk_score = max(75)
    $mitre_technique_id = array_distinct("T1499.001")
    $primary_entity = array_distinct($net.target.ip)
    $connection_count = count($net.metadata.id)
    $source_ips = array_distinct($net.principal.ip)
    $targeted_ports = array_distinct($net.target.port)

  condition:
    #net >= 300
}
