/*
  MITRE Technique : T1485 - Data Destruction
  Tactic(s)       : Impact
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : Cloud control plane (CloudTrail / Azure Activity / GCP Audit)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:36:35.231723+00:00
  Reference       : https://attack.mitre.org/techniques/T1485
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1485_Container_Persistent_Data_Resource_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects deletion of Kubernetes resources that hold or define persistent data (PersistentVolumeClaims, PersistentVolumes, VolumeSnapshots, StatefulSets, Namespaces), including bulk deletecollection calls, by a principal that is not an approved automation or admin identity. Such deletions can destroy stored data and its snapshots, impairing availability."
    mitre_tactic = "Impact"
    mitre_technique = "T1485"
    mitre_technique_name = "Data Destruction"
    log_prerequisites = "Kubernetes control-plane audit logging (API server audit events at Metadata level or higher) ingested into Chronicle and normalised to RESOURCE_DELETION, with the API verb and resource kind present in metadata.product_event_type and the caller in principal.user.userid."
    platform = "Containers"
    log_source = "cloud_audit"
    false_positives = "Legitimate CI/CD and GitOps controllers tearing down ephemeral environments, developers cleaning up test namespaces, StatefulSet scale-down or decommissioning, Helm uninstalls, scheduled snapshot-retention jobs, cluster autoscaler and storage operators."
    tuning_guidance = "Add GitOps, CI/CD and storage-operator identities to %global_allowed_service_accounts, and platform engineers to %global_allowed_admin_users. Add federated cloud identities that manage clusters to %global_allowed_cloud_principals. If volume snapshot cleanup is noisy, remove volumesnapshots from the resource regex. For production-only coverage, scope the rule to a cluster or namespace per client in a rule copy."

  events:
    $cloud.metadata.event_type = "RESOURCE_DELETION"
    $cloud.metadata.product_event_type = /(?i)(persistentvolumeclaims|persistentvolumes|volumesnapshots|volumesnapshotcontents|statefulsets|namespaces).*delete|delete.*(persistentvolumeclaims|persistentvolumes|volumesnapshots|volumesnapshotcontents|statefulsets|namespaces)/
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid = /^system:(kube-controller-manager|kube-scheduler|node:|serviceaccount:kube-system:)/ nocase
    not $cloud.principal.user.userid in %global_allowed_service_accounts
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1485")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $deleted_resource = array_distinct($cloud.target.resource.name)
    $api_action = array_distinct($cloud.metadata.product_event_type)
    $source_ip = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
