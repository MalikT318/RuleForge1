/*
  MITRE Technique : T1649 - Steal or Forge Authentication Certificates
  Tactic(s)       : Credential Access
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Identity Provider
  Log source      : Identity provider (Entra ID / Okta / AD)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T18:50:50.114275+00:00
  Reference       : https://attack.mitre.org/techniques/T1649
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1649_IdP_Certificate_Credential_Added_To_Identity {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects an identity provider audit event in which a certificate or key credential is added to, or a signing certificate is changed on, an application, service principal or federation trust. Adding certificate credentials to an identity, or replacing token-signing certificates, lets an adversary authenticate as that identity or forge tokens without a password or MFA."
    mitre_tactic = "Credential Access"
    mitre_technique = "T1649"
    mitre_technique_name = "Steal or Forge Authentication Certificates"
    log_prerequisites = "Requires identity provider directory/audit logs ingested and normalized to UDM, with metadata.product_event_type populated with the audit activity name. Application, service-principal and federation configuration auditing must be enabled."
    platform = "Identity Provider"
    log_source = "identity"
    false_positives = "Planned certificate rotation by application owners, automated certificate lifecycle or secret-rotation pipelines, new SSO or federation onboarding, scheduled token-signing certificate rollover by identity administrators, and application registrations created by DevOps pipelines."
    tuning_guidance = "Add automation and certificate-rotation identities to %global_allowed_service_accounts or %global_allowed_cloud_principals, and named identity administrators to %global_allowed_admin_users. Correlate with change tickets. If your parser maps these audit events to USER_RESOURCE_UPDATE_CONTENT instead of USER_CHANGE_PERMISSIONS, clone the rule with that event type. Do not combine both event types in a single rule."

  events:
    $idp.metadata.event_type = "USER_CHANGE_PERMISSIONS"
    $idp.metadata.product_event_type = /(certificates and secrets|service principal credentials|add service principal|keycredential|key credential|idp\.key\.(create|clone|update)|token.?signing|signing certificate|federat.*(certificate|settings))/ nocase
    not $idp.principal.user.userid in %global_allowed_service_accounts
    not $idp.principal.user.userid in %global_allowed_admin_users
    not $idp.principal.user.userid in %global_allowed_cloud_principals

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1649")
    $primary_entity = array_distinct($idp.principal.user.userid)
    $activity = array_distinct($idp.metadata.product_event_type)
    $target_resource = array_distinct($idp.target.resource.name)
    $source_ip = array_distinct($idp.principal.ip)

  condition:
    $idp
}
