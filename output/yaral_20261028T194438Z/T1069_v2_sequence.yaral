/*
  MITRE Technique : T1069 - Permission Groups Discovery
  Tactic(s)       : Discovery
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Containers
  Log source      : macOS endpoint (EDR / unified log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T00:55:33.848338+00:00
  Reference       : https://attack.mitre.org/techniques/T1069
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1069_Container_Kubeconfig_Read_Then_RBAC_Discovery {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "Medium"
    description = "On a macOS host, a process other than a recognised container or Kubernetes client reads a kubeconfig or container registry credential file. Within 10 minutes the same user runs a Kubernetes client command that enumerates RBAC roles, role bindings, service accounts or the caller's own permissions. This pairing indicates credential access followed by permission and group discovery against a cluster, not routine developer use of the CLI."
    mitre_tactic = "Discovery"
    mitre_technique = "T1069"
    mitre_technique_name = "Permission Groups Discovery"
    log_prerequisites = "macOS endpoint telemetry that normalises file read events (FILE_READ) and process launch events with full command lines and parent process paths. File-read auditing must cover hidden dot-directories under user home directories."
    platform = "Containers"
    log_source = "macos_endpoint"
    false_positives = "Developers or platform engineers using unlisted IDE plugins, cluster dashboards or GitOps tooling that read kubeconfig and then query RBAC. Onboarding and access-review scripts run by SRE teams. Security posture scanners that audit cluster permissions from a Mac."
    tuning_guidance = "Add approved Kubernetes tooling and access-audit scripts to %global_allowed_admin_tools (matched on the parent process of the discovery command). Add automation identities to %global_allowed_service_accounts. Extend the client-name exclusion regex on the file-read side with any in-house CLI wrappers. To tighten the rule further, require a non-interactive parent for the discovery command."

  events:
    $file.metadata.event_type = "FILE_READ"
    $file.target.file.full_path = /\/\.(kube\/config|docker\/config\.json)$/ nocase
    not $file.principal.process.file.full_path = /\/(kubectl|oc|helm|docker|com\.docker\.[a-z.\-]+|k9s|kubectx|kubens|stern|skaffold|tilt)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_service_accounts
    $file.principal.hostname = $host
    $file.principal.user.userid = $user

    $disc.metadata.event_type = "PROCESS_LAUNCH"
    $disc.target.process.file.full_path = /\/(kubectl|oc)$/ nocase
    $disc.target.process.command_line = /\b(auth\s+can-i\s+(--list|-l)|auth\s+whoami|(get|describe)\s+(cluster)?role(binding)?s?|(get|describe)\s+(serviceaccounts?|sa))\b/ nocase
    not $disc.principal.process.file.full_path in %global_allowed_admin_tools
    not $disc.principal.user.userid in %global_allowed_service_accounts
    $disc.principal.hostname = $host
    $disc.principal.user.userid = $user

    $file.metadata.event_timestamp.seconds <= $disc.metadata.event_timestamp.seconds

  match:
    $host, $user over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1069")
    $primary_entity = array_distinct($host)
    $acting_user = array_distinct($user)
    $credential_files = array_distinct($file.target.file.full_path)
    $reader_processes = array_distinct($file.principal.process.file.full_path)
    $discovery_commands = array_distinct($disc.target.process.command_line)
    $discovery_count = count($disc.metadata.id)

  condition:
    $file and $disc
}
