/*
  MITRE Technique : T1480.001 - Environmental Keying
  Tactic(s)       : Stealth
  Rule variant    : 1 of 7  (angle: Primary behavioral detection)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T05:24:40.237353+00:00
  Reference       : https://attack.mitre.org/techniques/T1480/001
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1480_001_Environment_Derived_Key_Decrypt_Execute {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects a script interpreter command line that reads host-specific environment values (domain, computer name, user, volume or system WMI data), applies a cryptographic decryption primitive, and executes the decrypted result in memory. This is the core mechanism of environmentally keyed payloads, where the decryption key is derived from the target environment."
    mitre_tactic = "Stealth"
    mitre_technique = "T1480.001"
    mitre_technique_name = "Execution Guardrails: Environmental Keying"
    log_prerequisites = "Requires Windows endpoint process telemetry with full command lines (EDR, Sysmon Event ID 1, or Security Event 4688 with command-line auditing). PowerShell script-block content is only covered if the pipeline normalises it into process command lines."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate administrative or deployment scripts that decrypt secrets using machine- or user-bound keys and run the result, such as credential bootstrap scripts, configuration management agents, and software packagers that use AES with a computer-name salt. Security researchers and red team exercises."
    tuning_guidance = "Add approved deployment, RMM, and configuration tooling to %global_allowed_admin_tools. Add trusted parent processes and hosts to %global_allowed_script_hosts. Add automation accounts to %global_allowed_service_accounts. If noise persists, tighten the execution clause to require in-memory assembly loading only."

  events:
    $proc.metadata.event_type = "PROCESS_LAUNCH"
    $proc.target.process.file.full_path = /\\(powershell|pwsh|powershell_ise)\.exe$/ nocase
    // Environment values used as key material
    $proc.target.process.command_line = /(\$env:(userdomain|userdnsdomain|computername|username|logonserver)|%(userdomain|userdnsdomain|computername|logonserver)%|\[environment\]::(machinename|userdomainname|username)|gethostname|getcomputernameex|win32_(computersystem|logicaldisk|volume|bios|baseboard|operatingsystem))/ nocase
    // Cryptographic decryption or key derivation
    $proc.target.process.command_line = /(createdecryptor|transformfinalblock|aesmanaged|aescryptoserviceprovider|rijndaelmanaged|rfc2898derivebytes|pbkdf2|convertto-securestring.{0,200}-key|system\.security\.cryptography)/ nocase
    // In-memory execution of the decrypted result
    $proc.target.process.command_line = /(\b(iex|invoke-expression)\b|\[reflection\.assembly\]::load|assembly\]::load|scriptblock\]::create)/ nocase
    not $proc.principal.process.file.full_path in %global_allowed_admin_tools
    not $proc.principal.process.file.full_path in %global_allowed_script_hosts
    not $proc.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1480.001")
    $primary_entity = array_distinct($proc.principal.hostname)
    $user = array_distinct($proc.principal.user.userid)
    $parent_process = array_distinct($proc.principal.process.file.full_path)
    $command_line = array_distinct($proc.target.process.command_line)

  condition:
    $proc
}
