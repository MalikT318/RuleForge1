/*
  MITRE Technique : T1070.008 - Clear Mailbox Data
  Tactic(s)       : Stealth
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T01:11:44.739550+00:00
  Reference       : https://attack.mitre.org/techniques/T1070/008
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1070_008_Linux_Mailbox_Store_Mass_Deletion {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "Detects a burst of file deletions inside local mailbox stores (mbox spool files, Maildir folders, virtual mail directories) on a single Linux host within 10 minutes, carried out by a process that is not a mail daemon or an approved tool. Individual mail deletions are routine. A volume of them outside the mail server's own process suggests an adversary removing phishing, collection or exfiltration evidence (T1070.008). This is a file-telemetry rule and does not depend on command-line matching."
    mitre_tactic = "Stealth"
    mitre_technique = "T1070.008"
    mitre_technique_name = "Indicator Removal: Clear Mailbox Data"
    log_prerequisites = "Requires Linux EDR file telemetry or auditd file-deletion (unlink/unlinkat) watches on mail spool and Maildir paths, normalised to UDM FILE_DELETION with principal.process and target.file.full_path populated."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Mail server maintenance (expunge, quota cleanup, mailbox migration), user-run mail clients with a local Maildir, cron-based mail spool rotation or purge jobs, backup or archival tools pruning mail directories, and administrators deleting a departed user's mailbox."
    tuning_guidance = "Add approved mail maintenance and housekeeping binaries to %global_allowed_admin_tools, backup and archival tools to %global_allowed_backup_processes, and mail or automation accounts to %global_allowed_service_accounts. Raise the #file threshold on busy mail hosts. Mail daemons (dovecot, cyrus, postfix, exim, procmail) are excluded by name in the rule; extend that regex if the MTA/MDA differs."

  events:
    $file.metadata.event_type = "FILE_DELETION"
    $file.target.file.full_path = /^\/var\/(spool\/)?mail\/[^\/]+$|\/maildir\/(cur|new|tmp|\.[^\/]+\/(cur|new|tmp))\/|^\/var\/(vmail|spool\/(imap|mail))\/.+|\/(mail|\.mail|mbox)\/[^\/]+$/ nocase
    $file.principal.hostname = $host
    not $file.principal.process.file.full_path = /\/(dovecot|imap|imap-login|lmtp|deliver|cyrus|master|postfix|local|exim4?|procmail|maildrop)$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_backup_processes
    not $file.principal.user.userid in %global_allowed_service_accounts

  match:
    $host over 10m

  outcome:
    $risk_score = max(65)
    $mitre_technique_id = array_distinct("T1070.008")
    $primary_entity = array_distinct($host)
    $deleted_file_count = count($file.metadata.id)
    $acting_users = array_distinct($file.principal.user.userid)
    $acting_processes = array_distinct($file.principal.process.file.full_path)
    $sample_deleted_paths = array_distinct($file.target.file.full_path)

  condition:
    #file >= 10
}
