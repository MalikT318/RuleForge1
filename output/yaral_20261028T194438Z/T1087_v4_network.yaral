/*
  MITRE Technique : T1087 - Account Discovery
  Tactic(s)       : Discovery
  Rule variant    : 4 of 6  (angle: Network-side observation)
  Rule type       : single-event
  Priority tier   : Discovery (System / Network / Account)
  Target platform : Linux
  Log source      : Linux endpoint (EDR / auditd)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T22:51:05.587429+00:00
  Reference       : https://attack.mitre.org/techniques/T1087
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1087_Linux_Outbound_Directory_Service_Enumeration {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects a Linux host making an outbound connection to a directory or authentication service port (LDAP 389/636, Global Catalog 3268/3269, Kerberos 88, SMB 445) on a non-internal address. The connecting process is not a standard identity-integration daemon. Account enumeration over the network (LDAP queries, Kerberos user probing, SMB/RPC user listing) produces this connection pattern regardless of which client binary is used. Internal address space is excluded through a reference list. Directory protocols leaving the network are rare, and only a small set of legitimate services (for example hosted directory integrations) do this."
    mitre_tactic = "Discovery"
    mitre_technique = "T1087"
    mitre_technique_name = "Account Discovery"
    log_prerequisites = "Requires Linux endpoint network telemetry (EDR or auditd with socket/connect auditing) that populates principal.process.file.full_path, target.ip and target.port on NETWORK_CONNECTION events."
    platform = "Linux"
    log_source = "linux_endpoint"
    false_positives = "Hosts authenticating to a hosted or cloud directory (secure LDAP, managed AD) through a non-standard client; custom SSO or identity-sync agents; vulnerability scanners and authorised pentest hosts; admin troubleshooting of directory connectivity; Kerberos realms reached through public addresses."
    tuning_guidance = "Add approved identity-sync and directory client binaries to %global_allowed_admin_tools, authorised scanner hosts to %global_allowed_scanners, and automation accounts to %global_allowed_service_accounts. Add hosts that legitimately use a hosted directory to %global_allowed_script_hosts. Add known-good directory provider domains to %global_allowed_domains if the log source also populates target.hostname. Extend the daemon-name exclusion regex if the client environment uses additional identity daemons."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    $net.principal.hostname != ""
    $net.principal.process.file.full_path = /^\//
    (
      $net.target.port = 389 or
      $net.target.port = 636 or
      $net.target.port = 3268 or
      $net.target.port = 3269 or
      $net.target.port = 88 or
      $net.target.port = 445
    )
    not $net.target.ip in %rfc1918_internal
    not $net.principal.process.file.full_path = /\/(sssd|sssd_be|sssd_nss|sssd_pam|nslcd|nscd|winbindd|smbd|slapd|krb5kdc|kadmind|realmd|adcli|systemd|systemd-resolved|chronyd|ntpd|sshd)$/ nocase
    not $net.principal.process.file.full_path in %global_allowed_admin_tools
    not $net.principal.process.file.full_path in %global_allowed_security_tools
    not $net.principal.user.userid in %global_allowed_service_accounts
    not $net.principal.hostname in %global_allowed_scanners
    not $net.principal.hostname in %global_allowed_script_hosts

  outcome:
    $risk_score = max(55)
    $mitre_technique_id = array_distinct("T1087")
    $primary_entity = array_distinct($net.principal.hostname)
    $source_user = array_distinct($net.principal.user.userid)
    $source_process = array_distinct($net.principal.process.file.full_path)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    $net
}
