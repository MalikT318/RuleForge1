/*
  MITRE Technique : T1657 - Financial Theft
  Tactic(s)       : Impact
  Rule variant    : 5 of 7  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : SaaS
  Log source      : Microsoft 365 / Google Workspace
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T19:01:13.523894+00:00
  Reference       : https://attack.mitre.org/techniques/T1657
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1657_SaaS_Mailbox_Rule_Forwarding_BEC_Setup {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects creation or modification of mailbox inbox rules, forwarding settings or transport rules in a SaaS email tenant. Business email compromise actors set these up after account takeover to hide or redirect payment and invoice correspondence before committing financial fraud."
    mitre_tactic = "Impact"
    mitre_technique = "T1657"
    mitre_technique_name = "Financial Theft"
    log_prerequisites = "Requires Microsoft 365 or Google Workspace unified audit logs with Exchange admin and mailbox audit operations ingested and normalised to SETTING_MODIFICATION events, with metadata.product_event_type populated."
    platform = "SaaS"
    log_source = "m365"
    false_positives = "Users creating legitimate inbox organisation rules, out-of-office or delegate forwarding, helpdesk or mail-migration administrators, onboarding and offboarding automation, shared mailbox configuration."
    tuning_guidance = "Add approved administrators to %global_allowed_admin_users and automation or migration identities to %global_allowed_service_accounts. Where the parser exposes rule parameters, add a condition on forward, redirect or delete actions or on finance keywords to raise fidelity. Consider escalating severity when the same user also has a risky sign-in."

  events:
    $cloud.metadata.event_type = "SETTING_MODIFICATION"
    $cloud.metadata.product_event_type = /^(New-InboxRule|Set-InboxRule|UpdateInboxRules|Set-Mailbox|New-TransportRule|Set-TransportRule)$/ nocase
    $cloud.principal.user.userid != ""
    not $cloud.principal.user.userid in %global_allowed_admin_users
    not $cloud.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1657")
    $primary_entity = array_distinct($cloud.principal.user.userid)
    $operations = array_distinct($cloud.metadata.product_event_type)
    $source_ips = array_distinct($cloud.principal.ip)

  condition:
    $cloud
}
