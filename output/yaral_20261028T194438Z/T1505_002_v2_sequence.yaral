/*
  MITRE Technique : T1505.002 - Transport Agent
  Tactic(s)       : Persistence
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:27:53.032405+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/002
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_002_Transport_Agent_DLL_Drop_Then_AgentsConfig_Change {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "Detects a DLL written to an Exchange or commonly abused staging directory, followed within 10 minutes on the same host by a modification of the Exchange transport agents.config file. This sequence is consistent with registering a malicious transport agent for persistence. It relies on file telemetry, not command-line matching."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.002"
    mitre_technique_name = "Server Software Component: Transport Agent"
    log_prerequisites = "Requires Windows endpoint file-creation and file-modification telemetry (EDR or Sysmon) on Exchange servers, with full target file paths and the initiating process path populated."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Legitimate third-party transport agents (anti-spam, DLP, journaling, email signature products) being installed or upgraded. Exchange cumulative update or security patch installation. Exchange administrators deploying approved custom agents."
    tuning_guidance = "Add approved deployment and patching tooling to %global_allowed_admin_tools, which is applied to the initiating process on both events. Scope the rule to Exchange servers with an asset-based filter in the client environment. Suppress change windows for planned Exchange upgrades."

  events:
    $drop.metadata.event_type = "FILE_CREATION"
    $drop.target.file.full_path = /\\(TransportRoles|Exchange Server|ExchangeServer|ProgramData|Windows\\Temp|Users\\Public)\\.*\.dll$/ nocase
    not $drop.principal.process.file.full_path in %global_allowed_admin_tools
    $drop.principal.hostname = $hostname

    $cfg.metadata.event_type = "FILE_MODIFICATION"
    $cfg.target.file.full_path = /\\TransportRoles\\Shared\\agents\.config$/ nocase
    not $cfg.principal.process.file.full_path in %global_allowed_admin_tools
    $cfg.principal.hostname = $hostname

    $drop.metadata.event_timestamp.seconds <= $cfg.metadata.event_timestamp.seconds

  match:
    $hostname over 10m

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.002")
    $primary_entity = array_distinct($cfg.principal.hostname)
    $dropped_dlls = array_distinct($drop.target.file.full_path)
    $dropper_processes = array_distinct($drop.principal.process.file.full_path)
    $config_modifiers = array_distinct($cfg.principal.process.file.full_path)
    $dll_event_count = count($drop.metadata.id)

  condition:
    $drop and $cfg
}
