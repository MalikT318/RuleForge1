/*
  MITRE Technique : T1132 - Data Encoding
  Tactic(s)       : Command and Control
  Rule variant    : 5 of 6  (angle: Alternate platform)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T02:44:48.378233+00:00
  Reference       : https://attack.mitre.org/techniques/T1132
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1132_ESXi_Encoded_Blob_In_Host_Setting {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "Medium"
    description = "Detects an ESXi host configuration or advanced-setting change whose value contains a long Base64-style encoded blob. Adversaries with shell or API access can stage encoded C2 configuration, commands or payloads in host settings and read them back later. This is a control-plane detection on SETTING_MODIFICATION events and does not depend on process command lines."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1132"
    mitre_technique_name = "Data Encoding"
    log_prerequisites = "Requires ESXi hostd and shell logs forwarded and parsed into UDM SETTING_MODIFICATION events, with the setting name in target.resource.name and the new value or log message text in security_result.description."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Certificate, key or thumbprint updates not covered by the name exclusion; syslog or monitoring integration settings holding encoded tokens; vendor lifecycle or backup plugins writing encoded configuration; admin automation (PowerCLI, esxcli scripts) that stores encoded values."
    tuning_guidance = "Add automation accounts to %global_allowed_service_accounts and named administrators to %global_allowed_admin_users. Extend the setting-name exclusion for customer-specific integrations that legitimately store encoded values. Raise or lower the 80-character minimum blob length per environment."

  events:
    $setting.metadata.event_type = "SETTING_MODIFICATION"
    $setting.security_result.description = /[A-Za-z0-9+\/]{80,}={0,2}/
    not $setting.target.resource.name = /(cert|thumbprint|ssl|pem|fingerprint|keystore)/ nocase
    not $setting.principal.user.userid in %global_allowed_service_accounts
    not $setting.principal.user.userid in %global_allowed_admin_users

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1132")
    $primary_entity = array_distinct($setting.principal.hostname)
    $changed_setting = array_distinct($setting.target.resource.name)
    $acting_user = array_distinct($setting.principal.user.userid)
    $source_ip = array_distinct($setting.principal.ip)

  condition:
    $setting
}
