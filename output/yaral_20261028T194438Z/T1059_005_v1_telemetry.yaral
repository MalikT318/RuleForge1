/*
  MITRE Technique : T1059.005 - Visual Basic
  Tactic(s)       : Execution
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Command and Scripting Interpreter
  Target platform : Windows
  Log source      : Windows endpoint (EDR / Sysmon / Security log)
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T20:12:35.985165+00:00
  Reference       : https://attack.mitre.org/techniques/T1059/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1059_005_VBScript_File_Dropped_By_Document_Or_Download_App {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of a VBScript-family file (.vbs, .vbe, .wsf, .wsh, .hta) in a user-writable or temporary location by an Office application, email client, web browser or archive utility. This is the file artifact left by macro droppers, phishing attachments and drive-by downloads that stage Visual Basic payloads for execution. It detects the written file, not the command line, so it still fires when process command-line logging is evaded or obfuscated."
    mitre_tactic = "Execution"
    mitre_technique = "T1059.005"
    mitre_technique_name = "Command and Scripting Interpreter: Visual Basic"
    log_prerequisites = "Requires Windows endpoint file-creation telemetry (EDR or Sysmon Event ID 11) that populates the creating process path and the target file path."
    platform = "Windows"
    log_source = "windows_endpoint"
    false_positives = "Users saving or extracting legitimate admin scripts from a browser, email or archive; Office add-ins or macros that generate .hta/.wsf helper files; software installers delivered through a browser that unpack script helpers into temp; IT staff downloading scripts for deployment."
    tuning_guidance = "Add approved deployment or IT tooling to %global_allowed_admin_tools, trusted automation accounts to %global_allowed_service_accounts, and approved script-authoring hosts or parents to %global_allowed_script_hosts. If a client routinely distributes .wsf or .hta business tools, narrow the extension group in the regex. To widen coverage, add explorer.exe to the creator process group, but expect more noise from user zip extraction."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /\.(vbs|vbe|wsf|wsh|hta)$/ nocase
    $file.target.file.full_path = /\\(users\\[^\\]+\\(appdata|downloads|desktop|documents)|windows\\temp|programdata|temp)\\/ nocase
    $file.principal.process.file.full_path = /\\(winword|excel|powerpnt|outlook|msaccess|mspub|onenote|chrome|msedge|firefox|iexplore|brave|opera|7z|7zfm|winrar|winzip)\.exe$/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.process.file.full_path in %global_allowed_script_hosts
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1059.005")
    $primary_entity = array_distinct($file.principal.hostname)
    $dropped_file = array_distinct($file.target.file.full_path)
    $creator_process = array_distinct($file.principal.process.file.full_path)
    $acting_user = array_distinct($file.principal.user.userid)

  condition:
    $file
}
