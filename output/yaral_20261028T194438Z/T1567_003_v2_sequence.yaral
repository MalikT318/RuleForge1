/*
  MITRE Technique : T1567.003 - Exfiltration to Text Storage Sites
  Tactic(s)       : Exfiltration
  Rule variant    : 2 of 6  (angle: Multi-event sequence (correlation))
  Rule type       : correlation, window 10m
  Priority tier   : Unprioritized (long tail)
  Target platform : Windows
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T16:59:15.768182+00:00
  Reference       : https://attack.mitre.org/techniques/T1567/003
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1567_003_Paste_Site_Lookup_Then_Upload_Proxy {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Sequence"
    severity = "High"
    description = "A source host resolves a paste or text-storage style domain and, within 10 minutes, sends an HTTP POST or PUT with a non-trivial upload body to an external paste-style host. Combining the DNS lookup with the outbound upload filters out casual browsing and indicates possible data exfiltration to a text storage site."
    mitre_tactic = "Exfiltration"
    mitre_technique = "T1567.003"
    mitre_technique_name = "Exfiltration Over Web Service: Exfiltration to Text Storage Sites"
    log_prerequisites = "Requires firewall or web proxy logs normalised to UDM NETWORK_DNS and NETWORK_HTTP, with principal.ip, network.http.method, network.sent_bytes and target.hostname populated. The proxy must inspect HTTP (TLS inspection or CONNECT metadata with byte counts)."
    platform = "Windows"
    log_source = "firewall"
    false_positives = "Developers and IT staff posting snippets or logs to sanctioned paste or snippet services, security researchers, helpdesk staff sharing diagnostics, internal wiki or snippet tools whose names contain paste or snippet, and web proxies that log DNS and HTTP under a shared egress IP."
    tuning_guidance = "Add sanctioned paste or snippet domains to %global_allowed_domains, scanner or research egress addresses to %global_allowed_scanners, and raise the sent_bytes threshold in noisy environments. If hostnames are populated more reliably than IPs, swap the join variable to principal.hostname. Extend the hostname keyword regex with additional generic text-storage terms as needed."

  events:
    $dns.metadata.event_type = "NETWORK_DNS"
    $dns.network.dns.questions.name = /(paste|snippet|textbin|notebin)/ nocase
    not $dns.network.dns.questions.name in %global_allowed_domains
    not $dns.principal.ip in %global_allowed_scanners
    $dns.principal.ip = $src_ip

    $http.metadata.event_type = "NETWORK_HTTP"
    $http.network.http.method = /^(POST|PUT)$/ nocase
    $http.target.hostname = /(paste|snippet|textbin|notebin)/ nocase
    $http.network.sent_bytes > 512
    not $http.target.hostname in %global_allowed_domains
    not $http.target.ip in %rfc1918_internal
    not $http.principal.ip in %global_allowed_scanners
    $http.principal.ip = $src_ip

    $dns.metadata.event_timestamp.seconds <= $http.metadata.event_timestamp.seconds

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(70)
    $mitre_technique_id = array_distinct("T1567.003")
    $primary_entity = array_distinct($src_ip)
    $destination_hosts = array_distinct($http.target.hostname)
    $destination_ips = array_distinct($http.target.ip)
    $total_bytes_sent = sum($http.network.sent_bytes)
    $upload_count = count($http.metadata.id)

  condition:
    $dns and $http
}
