/*
  MITRE Technique : T1505.006 - vSphere Installation Bundles
  Tactic(s)       : Persistence
  Rule variant    : 1 of 6  (angle: Telemetry abstraction level)
  Rule type       : single-event
  Priority tier   : Unprioritized (long tail)
  Target platform : ESXi
  Log source      : VMware / ESXi / hypervisor
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-29T06:34:27.671779+00:00
  Reference       : https://attack.mitre.org/techniques/T1505/006
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1505_006_ESXi_VIB_Artifact_Written {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Single-Event"
    severity = "High"
    description = "Detects creation of vSphere Installation Bundle artifacts on an ESXi host: .vib or .vgz bundle files, installed-VIB metadata under the esximg database, or boot-bank payload files (.v00-.v99). It pivots on the resulting file state rather than the esxcli command line, so it still fires when command-line logging is evaded, the bundle is installed by a renamed binary, or the install uses --force with a lowered acceptance level."
    mitre_tactic = "Persistence"
    mitre_technique = "T1505.006"
    mitre_technique_name = "Server Software Component: vSphere Installation Bundles"
    log_prerequisites = "Requires ESXi shell/hostd/file-integrity telemetry normalised to UDM FILE_CREATION events with target.file.full_path populated."
    platform = "ESXi"
    log_source = "vmware_esxi"
    false_positives = "Legitimate ESXi patching and upgrades (lifecycle manager baselines), hardware vendor driver or agent VIB installs, backup or monitoring agent deployments, and administrators staging approved bundles on datastores."
    tuning_guidance = "Add approved patching, lifecycle, and deployment binaries to %global_allowed_admin_tools and named change-window administrators to %global_allowed_admin_users. Add automation accounts to %global_allowed_service_accounts. If bundle staging on datastores is noisy, narrow the path regex to the VIB database and boot-bank locations only."

  events:
    $file.metadata.event_type = "FILE_CREATION"
    $file.target.file.full_path = /(\.(vib|vgz)$|\/var\/db\/esximg\/vibs\/|\/(bootbank|altbootbank)\/[^\/]+\.v[0-9]{2}$)/ nocase
    not $file.principal.process.file.full_path in %global_allowed_admin_tools
    not $file.principal.user.userid in %global_allowed_admin_users
    not $file.principal.user.userid in %global_allowed_service_accounts

  outcome:
    $risk_score = max(80)
    $mitre_technique_id = array_distinct("T1505.006")
    $primary_entity = array_distinct(strings.coalesce($file.principal.hostname, $file.target.hostname))
    $created_files = array_distinct($file.target.file.full_path)
    $acting_users = array_distinct($file.principal.user.userid)
    $acting_processes = array_distinct($file.principal.process.file.full_path)

  condition:
    $file
}
