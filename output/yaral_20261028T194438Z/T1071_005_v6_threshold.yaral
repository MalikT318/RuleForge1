/*
  MITRE Technique : T1071.005 - Publish/Subscribe Protocols
  Tactic(s)       : Command and Control
  Rule variant    : 6 of 6  (angle: Threshold / aggregation)
  Rule type       : threshold, window 10m
  Priority tier   : App-layer C2 and Ingress Tool Transfer
  Target platform : Network Devices
  Log source      : Firewall / proxy / network perimeter
  ATT&CK version  : 19.1
  Generated by    : Fuel iX (claude-sonnet-5-5) via gap_ruleforge.py
  Generated at    : 2026-10-28T21:12:03.802066+00:00
  Reference       : https://attack.mitre.org/techniques/T1071/005
  NOTE: AI-generated. Review, tune, and test before production deployment.
        Static checks only - verify UDM field names before deploying.
*/

rule MSSP_T1071_005_PubSub_Broker_Connection_Volume {
  meta:
    author = "TELUS Automated Detection Pipeline"
    rule_type = "Threshold"
    severity = "Medium"
    description = "A single internal source makes repeated connections to external destinations on publish/subscribe broker ports (MQTT 1883/8883, AMQP 5671/5672, STOMP 61613/61614, XMPP 5222/5223) within ten minutes. One such connection is benign, but sustained or beacon-like volume to an external broker suggests pub/sub used as a command-and-control channel."
    mitre_tactic = "Command and Control"
    mitre_technique = "T1071.005"
    mitre_technique_name = "Application Layer Protocol: Publish/Subscribe Protocols"
    log_prerequisites = "Requires firewall or perimeter connection logs normalised to UDM NETWORK_CONNECTION with principal.ip, target.ip and target.port populated."
    platform = "Network Devices"
    log_source = "firewall"
    false_positives = "IoT or building-management gateways publishing to cloud MQTT brokers, corporate messaging or XMPP clients, SaaS integrations using AMQP, and developer or test workloads using hosted message brokers."
    tuning_guidance = "Add known IoT gateways and authorised scanners to %global_allowed_scanners, and approved vendor broker hostnames to %global_allowed_domains. Raise the #net threshold in noisy IoT-heavy environments. Review the destination IP and port outcomes to confirm the broker is unsanctioned."

  events:
    $net.metadata.event_type = "NETWORK_CONNECTION"
    (
      $net.target.port = 1883 or
      $net.target.port = 8883 or
      $net.target.port = 5672 or
      $net.target.port = 5671 or
      $net.target.port = 61613 or
      $net.target.port = 61614 or
      $net.target.port = 5222 or
      $net.target.port = 5223
    )
    $net.principal.ip = $src_ip
    not $net.target.ip in %rfc1918_internal
    not $net.principal.ip in %global_allowed_scanners
    not $net.target.hostname in %global_allowed_domains

  match:
    $src_ip over 10m

  outcome:
    $risk_score = max(60)
    $mitre_technique_id = array_distinct("T1071.005")
    $primary_entity = array_distinct($src_ip)
    $connection_count = count($net.metadata.id)
    $destination_ips = array_distinct($net.target.ip)
    $destination_ports = array_distinct($net.target.port)

  condition:
    #net >= 10
}
